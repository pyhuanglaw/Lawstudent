diff --git a/src/econff3d.js b/src/econff3d.js
index 0dfd0038..b5d74fba 100644
--- a/src/econff3d.js
+++ b/src/econff3d.js
@@ -154,11 +154,13 @@ const ECONFF=(()=>{
     return n; };
   const setT=(G,E,day,h)=>{ if(day!==G.day){ G.day=day; G.weekday=wdOf(day);   /* 0＝週日（game3d 的 WEEK、sleepNow 都是 0；原本 ||7 會錯開，AA-C 10-18 回報）*/ G.energy=100; if(G.flags) G.flags.companion=null; G.weather=(typeof CALENDAR!=='undefined'&&CALENDAR.typhoon&&CALENDAR.typhoon(day))?'rain':'clear'; } G.hour=h; if(E) E.hour=G.hour; };
   /* 往前跳到 (day,h)：每 15 分鐘走一格，整點跑手機規則；收到要回的訊息就停（回傳 'msg'）*/
-  S.jumpTo=function(GM,day,h){ const G=GM.G, E=GM.E; const target=day*24+h; const p0=typeof PHONE!=='undefined'&&PHONE.pending?PHONE.pending(G).length:0; let t=G.day*24+G.hour;
+  S.jumpTo=function(GM,day,h){ const G=GM.G, E=GM.E; const target=day*24+h; const p0=typeof PHONE!=='undefined'&&PHONE.pending?PHONE.pending(G).length:0; let t=G.day*24+G.hour, mo=null;
+    const paid=()=>{ if(mo&&GM.toast) GM.toast(mo.text,3800); };
     while(t+0.25<=target+1e-6){ t=Math.round((t+0.25)*4)/4; const d=(h>=24&&t>=day*24)?day:Math.floor(t/24); setT(G,E,d,t-d*24);   /* h≥24：深夜還算前一天（遊戲的「過了午夜還是晚上」）*/
+      if(Math.abs(t-Math.round(t))<1e-6&&typeof STORY!=='undefined'&&STORY.monthlyFunds){ const f=STORY.monthlyFunds(G); if(f){ if(GM.money) GM.money(f.amount); mo=f; } }   /* 住宿舍的月份也照月匯（BUG-ECON-OCT-ALLOWANCE-1021：原本只有搬回家以後的 HOME.y0Jump 會匯，10/1 那筆一直沒匯，到 10/31 搬家才照在家的 5,000 匯）*/
       if(Math.abs(t-Math.round(t))<1e-6&&typeof PHONE!=='undefined'){ let got=0; try{ if(typeof STORY!=='undefined'&&STORY.phoneRules) STORY.phoneRules(GM); PHONE.tick(G,o=>{ got+=(o&&o.length)|0; }); }catch(e){ console.warn('ECONFF phone',e); }
-        if((PHONE.pending&&PHONE.pending(G).length>p0)||got>0) return 'msg'; } }   /* 任何新訊息都停（使用者 10-18 15:4x），打開那一段、按「跳過」繼續 */
-    setT(G,E,day,h); return 'ok'; };
+        if((PHONE.pending&&PHONE.pending(G).length>p0)||got>0){ paid(); return 'msg'; } } }   /* 任何新訊息都停（使用者 10-18 15:4x），打開那一段、按「跳過」繼續 */
+    setT(G,E,day,h); paid(); return 'ok'; };
   async function sitIn(GM,it){ const E=GM.E, P=E.player; const room=it.room&&it.room.room; const seats=((E.zone&&E.zone.seats)||[]).filter(q=>!room||q.room===room);
     const free=seats.filter(q=>!GM.freeSeat||GM.freeSeat(q)===q); const st=free[Math.floor(free.length/2)]||seats[0]; if(st&&GM.sitAt) GM.sitAt(P,st); return {st,free}; }
   /* 有劇情的課：帶到教室坐好，講到話的同學坐在附近，上課 */
diff --git a/tests/econ_ff_unit.js b/tests/econ_ff_unit.js
index 2c100e1a..dedaaa50 100644
--- a/tests/econ_ff_unit.js
+++ b/tests/econ_ff_unit.js
@@ -56,6 +56,12 @@ const mkG=(k,h,f)=>({stage:'econ',day:dayOf(k),hour:h,weekday:CALENDAR.dateOf(da
 { const G=mkG('2024-09-09',11); const a=ECONFF.lineFor(G,dayOf('2024-09-09'),dayOf('2024-09-18')); check('⑤ 9/9 → 9/18：「三棟樓之間的路……」',/三棟樓之間的路/.test(a||''),a);
   check('⑤ 只隔一天：沒有',ECONFF.lineFor(G,dayOf('2024-09-18'),dayOf('2024-09-19'))===null);
   ECONFF.rec(G).lines.push(a); const b=ECONFF.lineFor(G,dayOf('2024-09-09'),dayOf('2024-09-18')); check('⑤ 用過的不重複（同一段改用備用句）',b!==a&&!!b,b); }
+// BUG-ECON-OCT-ALLOWANCE-1021（BB 10-21 17:50）：住宿舍的月份跳日子也照月匯——9/30 跳到 10/2，10/1 匯一次（家裡匯錢的規則照 STORY.monthlyFunds，這裡用同樣的「換月才匯」）；修改前 jumpTo 沒叫，10/1 那筆一直沒匯
+{ const G=mkG('2024-09-30',21,{allowanceMonth:9}); G.money=1000; let toast=null; const S0=global.STORY.monthlyFunds, P0=global.STORY.phoneRules; global.STORY.phoneRules=()=>{}; pend=0;
+  global.STORY.monthlyFunds=g=>{ const m=CALENDAR.dateOf(g.day).m; if(g.flags.allowanceMonth===m) return null; g.flags.allowanceMonth=m; return {amount:30000,text:'家裡匯來這個月的生活費：30,000 元'}; };
+  const GM={G,E:null,money(n){ G.money+=n; },toast(t){ toast=t; }}; const r=ECONFF.jumpTo(GM,dayOf('2024-10-02'),8);
+  check('BUG-ECON-OCT-ALLOWANCE：9/30 跳到 10/2，10/1 照月匯一次（+30,000）、跳完提示一次',r==='ok'&&G.money===31000&&G.flags.allowanceMonth===10&&toast==='家裡匯來這個月的生活費：30,000 元',r+' money='+G.money+' toast='+toast);
+  global.STORY.monthlyFunds=S0; global.STORY.phoneRules=P0; }
 { const G=mkG('2024-10-15',22.6); const r=ECONFF.jumpTo({G,E:null},dayOf('2024-10-15'),24.5); check('⑥ 10/15 24:30：日子還是 10/15、時間 24.5（凌晨兩點的微積分的條件）',r==='ok'&&G.day===dayOf('2024-10-15')&&Math.abs(G.hour-24.5)<1e-6,G.day+' '+G.hour);
   const r2=ECONFF.jumpTo({G,E:null},dayOf('2024-10-16'),19); check('⑥ 接著跳到 10/16 19:00',r2==='ok'&&G.day===dayOf('2024-10-16')&&Math.abs(G.hour-19)<1e-6,G.day+' '+G.hour); }
 // ⑦ 睡覺、快轉＝到下一個事件（2026-10-18 使用者：「我每天睡覺到休學，還可以跟可昕告白，中間我們根本沒遇到」）
