im_gen1":["（群組）阿哲：吳教授今天一個「行為」講了一整個早上。你沒錯過什麼，也錯過了全部。","（群組）宥辰：我今天有去。對，我。","（群組）柏翰：今天的板書我整理好了，要的說一聲。"],"const_1":["（群組）Alison：張教授今天又發了二十頁講義，我幫你拿了一份。","（群組）以安：講義第四十頁到五十頁。下週會接著講。","（群組）阿哲：今天點名了嗎？沒有。你運氣很好。"],"ge_film_y1s1":["（群組：電影課小組）筱涵：老師今天放的片超好看，你錯過了。","（群組：電影課小組）筱涵：今天拍了一段走廊。你的部分我們先空著。"],"econ_principles_1":["（群組）芯慈：今天講外部性。你應該都會吧？","（群組）（不具名）經濟學原理小組：報告的分工表更新了。"],"const_2":["（群組）Alison：張教授今天講覆議，我畫了一張圖給你。","（群組）以安：講義第三十頁到四十頁。期末會考。","（群組）阿哲：張教授問有沒有人沒拿到講義。我幫你拿了。"],"crim_gen2":["（群組）阿哲：吳教授今天講正當防衛講到忘記下課。","（群組）宥辰：我今天有去。第二次。","（群組）柏翰：板書整理好了，二十頁。"],"oblig_gen1":["（群組）芯慈：今天周教授講要約引誘。網拍相機那題，他記得是你。","（群組）阿哲：周教授點你，我說你去實習。他說大一沒有實習。","（群組）柏翰：今天的條文整理我放在雲端了。"],"ge_y1s2":["（群組）宥辰：今天的天文課你沒來。很可惜。我很少這樣說。"],"econ_principles_2":["（群組）芯慈：今天講央行。你應該都會吧？……我不是在酸你。","（群組）阿哲：經原今天點名。我說你在重修別的東西。","（群組）明軒：今天講匯率。我更想出國了。"],"admin_law":["（群組）以安：許教授今天講行政處分。筆記在雲端。第三頁很重要。","（群組）阿哲：許教授今天講德文講了十分鐘。你錯過了文化交流。","（群組）柏翰：期中考範圍更新了。"],"crim_spec":["（群組）阿哲：吳教授今天講竊盜，舉例舉到他自己的雨傘。","（群組）柏翰：板書整理好了。三十頁。","（群組）宥辰：今天我有去。因為我前一天沒睡。"],"property":["（群組）芯慈：鄭教授今天的圖，我拍給你。三張。","（群組）阿哲：今天講相鄰關係，我想到我們宿舍。","（群組）柏翰：物權的條文整理，第二版。"],"oblig_gen2":["（群組）芯慈：周教授今天講給付遲延。他點了你的座位。","（群組）阿哲：周教授說「上禮拜被點到的那位同學今天沒來」。是你。","（群組）柏翰：債總的條文表，第三版。"],"ge_y2s1":["（群組：通識）阿凱：今天放了一首老歌，全班都會唱，只有我不會。"],"oblig_spec":["（群組）阿哲：葉教授今天帶了一份真的買賣契約。我們全班幫它挑錯。","（群組）芯慈：債各的條文表，第一版。","（群組）柏翰：期中考範圍更新了。"],"family_law":["（群組）芯慈：鄭教授今天畫的家族樹，我拍了。","（群組）Alison：今天講同性婚姻，我差點在課堂上哭。","（群組）阿哲：今天的親等題，我算錯三次。"],"admin_remedy":["（群組）以安：今天講課予義務訴訟。筆記在雲端。第五頁是重點。","（群組）阿哲：許教授今天講了二十分鐘的德國。","（群組）柏翰：行政救濟的流程圖，我畫好了。"],"legal_english":["（群組）明軒：法學英文今天讀了一個美國的判決。老師說，下週換你們寫摘要。"],"ge_y2s2":["（群組：通識）筱涵：今天的食物是豆花。你錯過了。"],"civpro_1":["（群組）芯慈：蔡教授今天請的律師好厲害。你錯過了。","（群組）阿哲：今天練習寫起訴狀，我寫了三頁還沒寫到聲明。","（群組）柏翰：民訴的筆記整理好了。"],"crimpro":["（群組）Alison：林教授今天問你去哪裡了。她記得你的名字。","（群組）芯慈：今天讀的判決，我畫了重點。","（群組）阿哲：刑訴今天講傳聞，我聽了兩小時還是傳聞。"],"company_law":["（群組）明軒：何教授今天開了三項議程。第三項沒開完。","（群組）芯慈：公司法的條文表，我做好了。"],"securities":["（群組）明軒：證交法今天講內線交易。何教授講得像在開記者會。"],"civpro_2":["（群組）芯慈：蔡教授今天請的律師講了她輸過的案子。","（群組）阿哲：今天寫起訴聲明，我寫成一首詩被唸了。","（群組）柏翰：甲下的筆記整理好了。"],"insurance":["（群組）阿哲：簡教授今天的第一句話：「出事了。」全班都醒了。","（群組）芯慈：保險法的條文表，我做好了。"],"negotiable":["（群組）芯慈：票據今天講背書。簡教授說：「不要亂簽名。」全班點頭。"],"labor_law":["（群組）明軒：勞動法今天講責任制。我去問了我家教的家長。","（群組）阿哲：老師今天說他上個月處理了一個案子，聽起來好像我打工的店。"],"enforcement":["（群組）阿哲：強執今天講查封。蔡教授請了執行處的書記官來。","（群組）芯慈：強執的流程圖，我畫好了。","（群組）柏翰：國考的強執考古題，我整理了十年份。"],"legal_ethics":["（群組）Alison：法律倫理今天討論了一整節課。我想了一整晚。","（群組）以安：今天的案例，我覺得你會有很多想法。下次說給我聽。"],"ip_law":["（群組）宥辰：智財今天講音樂授權。我全勤。這是第二門。"],"labor_social":["（群組）以安：勞動社會法今天講長照。我做了筆記。"],"tax_law":["（群組）芯慈：財稅法今天講房地合一。你要的話我把表給你。"],"crim_judgment_sem":["（群組）阿哲：刑事判決研討今天讀了一份四十頁的判決。我讀了三頁。"],"public_judgment_sem":["（群組）以安：公法研討今天讀了一份我很喜歡的判決。你沒來，我留了一份給你。"],"legal_research":["（私訊）以安：周老師今天問你的題目 我說你在寫了","（群組）阿哲：周教授今天問誰沒來 我說你肚子痛"],"maritime":["（群組）明軒：海商法今天講共同海損。老師講了一個港口的故事，講了二十分鐘。"],"japanese_1":["（群組：日文班）采蓁：今天學了邀約的說法！你沒來，我先邀你：来週、いっしょに勉強しませんか？","（群組：日文班）宇恆：今天小考。我考了。我也不知道我考了什麼。"],"japanese_2":["（群組：日文班）立衡：今天講敬語。筆記我拍了。","（群組：日文班）采蓁：今天的「大丈夫」好有趣！你一定要聽老師再講一次。"]},"pools":{"calc_y0s1":{"prof_label":"數學系老師","lines":["今天講極限。無限接近，但不一定到達。","導數就是瞬間的變化率。","邊際成本，就是成本函數的導數。經濟系的同學，記住這句。","求最大值：先微分，令它等於零。","鏈鎖律。一層一層剝開。","期中考：計算題八題，證明題兩題。","不會的題目，先跳過。微積分最怕卡在一題。"],"react":[{"who":"econ_zhengxun","text":"（已經寫完講義的習題）"},{"who":"econ_weilun","text":"無限接近，但不一定到達——這是我的期中考分數。"},{"who":"econ_pinyu","text":"我的筆記比老師的板書整齊。"}]},"chinese_y0":{"prof_label":"國文老師","lines":["今天讀一首詩。不用懂，先唸出聲音。","寫你家附近的一條路。不要用形容詞。","這週交一篇小品：寫一個你每天遇到、但不知道名字的人。","不要背註解。讀到有感覺的地方，停下來。","期中考是一篇作文。題目很簡單，寫好很難。"],"react":[{"who":"econ_weilun","text":"國文課是我的補眠時間。"},{"who":"econ_tangrui","text":"我可以用唸的交作業嗎？"}]},"english_y0":{"prof_label":"英文老師","lines":["這學期每個人要做一次三分鐘的英文報告。","新聞標題的英文，和內文的英文不一樣。","不要逐字翻譯。先懂意思，再找字。","今天分組討論。說錯沒關係，不說才有關係。","期中考：閱讀測驗和一篇短文。"],"react":[{"who":"econ_tangrui","text":"英文報告？交給我。"},{"who":"econ_pinyu","text":"我的報告題目是精算師。沒有人聽得懂。"}]},"pe_y0s1":{"prof_label":"體育老師","lines":["先跑兩圈操場。不要用走的。","今天打羽球，兩人一組。","下雨，改在體育館。","伸展做完才能走。","期中測驗：跑步。量的是你自己的進步。"],"react":[{"who":"econ_weilun","text":"這是我唯一不會遲到的課。"},{"who":"econ_zhengxun","text":"（跑步的時候在心裡算配速）"}]},"acct_y0_2":{"prof_label":"會計老師","lines":["下學期從成本會計開始。一杯飲料的成本是多少？","現金流量表：賺錢和有錢，是兩件事。","分析財報：比率不是答案，是問題。","期中考：一份完整的財報。","這學期有人休學了。座位空著，帳還是要平。"],"react":[{"who":"econ_zhengxun","text":"（多拿了一份講義，放在旁邊的空位）"},{"who":"econ_pinyu","text":"老師今天又講人生。"},{"who":"econ_weilun","text":"現金流量表……我只有流出。"}]},"calc_y0s2":{"prof_label":"數學系老師","lines":["今天進入多變數。函數不只一個變數了。","偏微分：一次只看一個變數動。","拉格朗日乘數：有限制的時候怎麼求最大。經濟系最常用。","積分：把小東西加起來。","期中考：計算題八題，應用題兩題。"],"react":[{"who":"econ_zhengxun","text":"拉格朗日是我的朋友。"},{"who":"econ_weilun","text":"我和微積分的關係很複雜。"},{"who":"econ_pinyu","text":"你和所有的科目關係都很複雜。"}]},"chinese_y0_2":{"prof_label":"國文老師","lines":["下學期讀散文。先讀一篇寫母親的。","寫一封信給一年前的自己。不用寄。","讀古文，先找動詞。","這週交一篇：寫一個你吃過最多次的東西。"],"react":[{"who":"econ_weilun","text":"我寫雞排。"},{"who":"econ_tangrui","text":"我寫給一年前的自己：你會很會講話。"}]},"english_y0_2":{"prof_label":"英文老師","lines":["下學期練口說。每週兩個人上台。","用三句話介紹你自己。不能說「我是經濟系的」。","聽力：先聽懂大意。","期末：五分鐘的英文報告。"],"react":[{"who":"econ_tangrui","text":"三句話？我可以講三十句。"},{"who":"econ_pinyu","text":"我的三句話：精算師、精算師、精算師。"}]},"pe_y0s2":{"prof_label":"體育老師","lines":["這學期打排球。先練接球。","下雨，改在體育館。","分組比賽。輸的那組收球。","伸展做完才能走。"],"react":[{"who":"econ_weilun","text":"排球我可以！"},{"who":"econ_zhengxun","text":"（接球的角度很精準）"}]},"chinese_y1":{"prof_label":"國文老師","lines":["今天讀一首詩。不用懂，先唸出聲音。","法律系的作文比別系長，但不一定比較好。","寫你家附近的一條路。不要用形容詞。","古人寫信，也是在處理人和人之間的事。","這週交一篇小品：寫一個你每天遇到、但不知道名字的人。","不要背註解。讀到有感覺的地方，停下來。","期中考是一篇作文。題目很簡單，寫好很難。","下課前五分鐘，誰願意唸一下自己寫的？"],"react":[{"who":"zhe","text":"國文課是我的補眠時間……"},{"who":"yu","text":"我寫了三頁。"},{"who":"classmate_peishan","text":"這首詩的最後一句，沒有答案。"}]},"english_y1":{"prof_label":"英文老師","lines":["今天的閱讀是一篇睡眠研究。對，你們需要。","這學期每個人要做一次三分鐘的英文報告。","新聞標題的英文，和內文的英文不一樣。","不要逐字翻譯。先懂意思，再找字。","今天分組討論。說錯沒關係，不說才有關係。","法律英文是大四的事。今天先學寫一封信。","期中考：閱讀測驗和一篇短文。"],"react":[{"who":"classmate_bohan","text":"（英文是他最怕的課，坐在最後一排）"},{"who":"classmate_xinci","text":"我的報告題目是行為經濟學。"},{"who":"classmate_youchen","text":"三分鐘報告可以用唱的嗎？"}]},"pe_y1s1":{"prof_label":"體育老師","lines":["先跑兩圈操場。不要用走的。","今天打羽球，兩人一組。","下雨，改在體育館做體能。","伸展做完才能走。","期中測驗：跑步。量的是你自己的進步。","今天自由練習。不要只坐在旁邊。"],"react":[{"who":"zhe","text":"這是我唯一不會遲到的課。"},{"who":"classmate_mingxuan","text":"（已經在投籃）"},{"who":"yu","text":"我的社團比體育課還累。"}]},"chinese_y1_2":{"prof_label":"國文老師","lines":["下學期讀散文。先讀一篇寫母親的。","寫一封信給一年前的自己。不用寄。","讀古文，先找動詞。","法律系的同學，你們的句子太長了。","這週交一篇：寫一個你吃過最多次的東西。","期中考：一篇作文，題目當天公布。","有人願意唸一下嗎？寫得不好也可以。"],"react":[{"who":"zhe","text":"國文課的作文我寫滷肉飯。"},{"who":"yu","text":"我寫了給一年前自己的信，寫到想哭。"},{"who":"classmate_peishan","text":"一年前的我，還不知道自己會在這裡。"}]},"english_y1_2":{"prof_label":"英文老師","lines":["下學期練口說。每週兩個人上台。","今天讀一段演講稿。注意停頓。","用三句話介紹你自己。不能說「我是法律系的」。","聽力：先聽懂大意，不要每個字都抓。","期末：五分鐘的英文報告。","說錯沒關係。不說才有關係。"],"react":[{"who":"classmate_bohan","text":"（輪到他上台前，他把稿子背了二十遍）"},{"who":"classmate_xinci","text":"我的報告題目還是行為經濟學。"},{"who":"classmate_youchen","text":"我可以用歌詞介紹自己嗎？"}]},"pe_y1s2":{"prof_label":"體育老師","lines":["這學期打排球。先練接球。","下雨，改在體育館。","分組比賽。輸的那組收球。","期末測驗：發球十顆，進八顆。","伸展做完才能走。"],"react":[{"who":"zhe","text":"排球我也可以！"},{"who":"classmate_mingxuan","text":"（一個人接了全隊的球）"},{"who":"yu","text":"我的社團比體育課還累。"}]},"pe_y2s1":{"prof_label":"體育老師","lines":["這學期是游泳。先在池邊熱身。","不會換氣的同學，站這一邊。","今天測二十五公尺。","游完記得沖澡。","下雨也游。反正都是濕的。"],"react":[{"who":"zhe","text":"游泳我也可以！"},{"who":"classmate_mingxuan","text":"（已經游完兩趟）"},{"who":"classmate_bohan","text":"（第一次下水，表情很嚴肅）"}]},"legal_practice":{"prof_label":"實習單位的指導律師","lines":["今天是你在實習單位的第一天。先把桌子整理好。","指導律師：「這份書狀，你先讀。不懂的畫起來，下午問我。」","今天的電話很多。每一通，都是一個人最煩惱的事。","法扶的值班：今天來了一位阿伯，他帶了一整袋的文件。","指導律師：「你今天說的那句話很好。下次，再說得短一點。」","開庭陪同：你坐在旁聽席，第一次看見自己準備的資料被用上。","實習的最後一天：「以後當了律師，記得今天的感覺。」"],"react":[{"who":"zhe","text":"（群組）今天影印了三百頁 手好痠"},{"who":"classmate_bohan","text":"（群組）實習的書狀被改得滿江紅。律師說第二版會好很多。"}]}},"second":{"civpro_1":["今天請一位律師來，談她的第一個案子。","上週的題目，我們用一份真的起訴狀看一次。","實務上，書狀寫得清楚，案子先贏一半。","今天練習寫訴之聲明。寫完交換看。","法庭不是電視劇。大部分時間在等。","下課前十分鐘，問律師任何問題。"],"crimpro":["今天讀一份判決。只讀事實和理由的第一段。","上週的問題，有同學寫信來。我們一起看。","程序不是麻煩。程序是保護你的那一層。","這段判決，你們覺得法官在想什麼？","下課前，我們做三題。不算分。","我記得每個人的名字。也記得誰常常不在。"]},"reviewed":["econ_principles_y0|1","econ_principles_