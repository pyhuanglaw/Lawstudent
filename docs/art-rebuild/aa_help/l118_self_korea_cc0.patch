+def acg(name, aid, maps=('diff', 'nor'), res=512, vary=None, **kw):
+    """ambientCG 材質組 → L.pbr 材質。vary：顏色貼圖的明暗起伏壓到平均亮度的這個比例（塑膠 0.05、灰泥 0.04；不壓會有黑紋、雲斑）"""
