+            d.line([(cx - math.cos(a) * L_, cy - math.sin(a) * L_), (cx + math.cos(a) * L_, cy + math.sin(a) * L_)], fill=hx(rr.choice(cols), rr.uniform(0.85, 1.1)), width=w)
+    for i in range(n * n):
