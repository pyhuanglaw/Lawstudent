+def _uvface(m, pts, uvs):
+    bm = m.bm; uvl = bm.loops.layers.uv.verify(); f = bm.faces.new([bm.verts.new(g2b(*p)) for p in pts])
+    for lp, uv in zip(f.loops, uvs): lp[uvl].uv = uv
+    f.normal_update()
+    return f
