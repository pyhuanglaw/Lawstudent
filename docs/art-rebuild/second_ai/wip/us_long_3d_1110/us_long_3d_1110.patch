+SEP, R_RIM, WIRE = 0.084, 0.023, 0.0012
+HW, HH, SQ = 0.023, 0.023, 2.0          # 正圓：半寬、半高、超橢圓次數（2＝圓）          # 鏡片中心距、鏡框半徑（中心線）、金屬線半徑
+B.reset(texres=256)
+M = {'frame': L.flat('glasses_frame', '#3a2a22', rough=0.38, metal=0.10),
