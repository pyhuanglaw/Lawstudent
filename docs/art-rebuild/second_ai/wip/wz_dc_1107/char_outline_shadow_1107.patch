+  const eng=fs.readFileSync(path.join(ROOT,'src/engine3d.js'),'utf8'); const i=eng.indexOf('function shadowLevels(SM)'), body=i>=0?eng.slice(i,eng.indexOf('E.cinematic=',i)):'';
