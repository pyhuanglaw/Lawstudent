+        ccyl(cm, (0, 0, -0.065), (0, 0, 0.065), 0.005, '#8d9196', seg=4)                            # 軸
+    pr = Proto(f'wheel{len(WHEELS)}', build, side=side); WHEELS[key] = pr; return pr
