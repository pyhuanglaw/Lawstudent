+        for(let j=0;j<LEG.length;j++){ if(!bA[j]||!bB[j]) continue; const d=bA[j].getWorldPosition(new THREE.Vector3()).distanceTo(bB[j].getWorldPosition(new THREE.Vector3()));
+          if(d>worst){ worst=d; worstAt=`${key} ${tag} 第 ${i} 幀 ${LEG[j]}`; } } } };
