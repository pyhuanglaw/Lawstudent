+    jb, bb = load(b); ib, bvb, new = img(jb, bb, name); ja['images'][ia]['mimeType'] = jb['images'][ib].get('mimeType', ja['images'][ia].get('mimeType'))
+else:   # B 也可以是一張圖檔（.webp／.png／.jpg）：照副檔名寫 mimeType
+    new = open(b, 'rb').read(); ja['images'][ia]['mimeType'] = {'webp': 'image/webp', 'png': 'image/png', 'jpg': 'image/jpeg', 'jpeg': 'image/jpeg'}[b.rsplit('.', 1)[1].lower()]
 off = bva.get('byteOffset', 0); pad = (-len(new)) % 4; d = len(new) + pad - (bva['byteLength'] + ((-bva['byteLength']) % 4))
 nb = ba[:off] + new + b'\0' * pad + ba[off + bva['byteLength'] + ((-bva['byteLength']) % 4):]
 for v in ja['bufferViews']:
