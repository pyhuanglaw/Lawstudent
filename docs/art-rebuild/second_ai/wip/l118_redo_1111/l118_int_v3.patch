+    n = int((X1 - X0) / step)
+    for k in range(1, n + 1): x = X0 + k * (X1 - X0) / (n + 1) if False else X0 + k * step; (m.quad([(x - w / 2, y, Z0), (x + w / 2, y, Z0), (x + w / 2, y, Z1), (x - w / 2, y, Z1)]) if x < X1 - 0.05 else None)
