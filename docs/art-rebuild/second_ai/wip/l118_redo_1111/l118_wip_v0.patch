+import json, os, sys
+from PIL import Image, ImageDraw, ImageFont, ImageFilter
+HERE = os.path.dirname(os.path.abspath(__file__)); sys.path.insert(0, HERE)
+import l118_food_tex as FD   # noqa: E402
