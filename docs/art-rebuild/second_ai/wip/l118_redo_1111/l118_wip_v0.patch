+def _pizza(c, kind):
+    c.table('dark'); c.shadow(0, 0, 1.08, 1.08); c.ell(0, 0, 1.1, 1.1, _rgb('#b98d5e')); c.ell(0, 0, 1.06, 1.06, _rgb('#c89a68'))                 # 木盤
