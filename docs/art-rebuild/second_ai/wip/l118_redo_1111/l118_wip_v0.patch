+    c.bits(-0.68, 0.1, 0.16, GREEN, 26, 0.02, 0.04, ry=0.2); c.bits(0, 0, 0.8, ['#f4f0e0'], 30, 0.006, 0.012, ry=0.5); c.gloss(0, 0, 0.7, 0.14, ry=0.4)
