+
+
+SIGN_TEXT = [('泡麵', 'NOODLES'), ('醬料', 'SAUCES'), ('零食、餅乾', 'SNACKS'), ('乾貨、茶葉', 'DRY GOODS · TEA')]
+DEPT = [('米', 'RICE'), ('冷凍', 'FROZEN'), ('青菜、豆腐', 'PRODUCE · TOFU'), ('飲料', 'DRINKS')]
+
+
+def tex_signs(path):
