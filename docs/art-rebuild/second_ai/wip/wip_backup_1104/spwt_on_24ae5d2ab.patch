+        x = xc + (xf - xc) * abs(s) ** (2 / p) if s >= 0 else xc - (xc - xb) * abs(s) ** (2 / pb)
+        out.append((x, y, hw * math.copysign(abs(c) ** (2 / p), c)))
+    return out
