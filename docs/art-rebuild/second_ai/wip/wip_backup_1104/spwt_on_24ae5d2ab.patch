+    if dif:
+        tx = nt.nodes.new('ShaderNodeTexImage'); tx.image = bpy.data.images.load(os.path.join(d, dif)); tx.projection = 'BOX'; tx.projection_blend = 0.2
+        nt.links.new(mp.outputs['Vector'], tx.inputs['Vector'])
