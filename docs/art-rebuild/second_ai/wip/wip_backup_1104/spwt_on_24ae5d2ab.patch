+GONDOLAS = [{'x': -4.6, 'cat': 'noodles', 'aisle': 1}, {'x': -1.2, 'cat': 'sauce', 'aisle': 2}, {'x': 2.2, 'cat': 'snacks', 'aisle': 3}, {'x': 5.0, 'cat': 'dry', 'aisle': 4}]
