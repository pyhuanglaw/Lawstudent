+        if kind == 'stain' or rr.random() < 0.5: stains(img, cx, cy, cx + cw, cy + ch, rr, 14)
+    img.save(os.path.join(GEN, 'gg_bd_facade.png')); night.save(os.path.join(GEN, 'gg_bd_facade_night.png'))
