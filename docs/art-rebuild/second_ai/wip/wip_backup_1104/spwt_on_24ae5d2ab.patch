+    mx = N('ShaderNodeMixShader'); K(fac, mx.inputs['Fac']); K(tr.outputs[0], mx.inputs[1]); K(em.outputs[0], mx.inputs[2])
+    out = N('ShaderNodeOutputMaterial'); K(mx.outputs[0], out.inputs['Surface'])
+    return mt
+sm = steam_mat()
+for k, ang in enumerate((0.0, 1.05, 2.1)):
