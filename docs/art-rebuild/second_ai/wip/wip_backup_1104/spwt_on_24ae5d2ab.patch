+# ================= 共用零件（遊戲座標；yaw 只用 0、±π/2、π） =================
+def rot(x, z, yaw):
+    """區域座標的旋轉：面向 yaw（(sin, cos)）的本地座標 (lx 右手邊, lz 前方) → 世界的位移"""
+    f = (math.sin(yaw), math.cos(yaw)); r = (math.cos(yaw), -math.sin(yaw))
+    return lambda lx, lz: (x + lx * r[0] + lz * f[0], z + lx * r[1] + lz * f[1])
