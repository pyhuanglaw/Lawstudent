+    def back(u, v):
+        xx = -0.2 + 0.4 * u; xn = xx / 0.2; y = 0.6 + 0.26 * v; zz = -0.215 - 0.05 * v + 0.025 * xn * xn
+        e = max(0.0, abs(2 * v - 1) - 0.6) / 0.4; xx *= 1 - 0.08 * e * e
+        return (xx, y, zz)
+    ply_shell(c.wood, M, back, 8, 5, (0.0, 0.0, -0.016))
