+chx, chz = 0.35, -0.62
+for sx in (-1, 1):
+    tube(st, (chx + sx * 0.2, 0.0, chz + 0.2), (chx + sx * 0.2, 0.46, chz + 0.02), 0.011, '#5d6166')
