+        col, kind, wstyle, pg, pac, curt = FACADES[k]; base = hexc(col)
+        d.rectangle([cx, cy, cx + cw - 1, cy + ch - 1], fill=base); tile_lines(d, cx, cy, cx + cw, cy + ch, base, kind if kind != 'glass' else 'tile', rr)
+        for f in range(4):   # 由上往下：第 0 列是最上面那一層
