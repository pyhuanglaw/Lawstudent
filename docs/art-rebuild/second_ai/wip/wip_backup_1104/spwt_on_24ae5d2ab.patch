+    GON.append({'x': round(x, 2), 'z0': -9.0, 'z1': 5.4, 'd': 1.2, 'h': 1.95, 'aisle': k + 1,
+                'cat': ['cereal', 'snacks', 'drinks', 'canned', 'pasta', 'baking', 'household', 'personal'][k]})
+L['gondolas'] = GON
