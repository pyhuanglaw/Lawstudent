+    for k in range(n + 1):
+        u = -L_ / 2 + k * (L_ / n)
+        st.cyl(P(u, 0.0, -0.05), P(u, 0.36, -0.05), 0.03, seg=6); st.cyl(P(u, 0.01, -0.3), P(u, 0.01, 0.2), 0.025, seg=6)
+    for k in range(n * 3):
+        u = -L_ / 2 + 0.31 + k * 0.62
+        a, b_ = P(u - 0.26, 0.4, -0.22), P(u + 0.26, 0.47, 0.22)
