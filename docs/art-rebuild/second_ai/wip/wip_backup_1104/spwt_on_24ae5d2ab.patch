+    n = bad = 0; byobj = {}; ex = {}; seatbad = []
+    for x, z, kind in pts:
+        for k in range(8):
+            yaw = k * math.pi / 4; fx, fz = math.sin(yaw), math.cos(yaw)
+            head = np.array([x, 1.45, z])
+            cam = follow(head, yaw)
