+        d.rectangle([x, yt, x + w - 2, yt + 5], fill=(236, 232, 224))
+        d.rectangle([x + w * 0.15, yt + hh * 0.35, x + w * 0.85, yt + hh * 0.55], fill=T.hx(r.choice(['#f5d23a', '#f5f1e6', '#2b2b2b'])))
