+    for i in range(nu + 1):
+        u = u0 + (u1 - u0) * i / nu; row = []
+        for j in range(nt + 1):
+            t = tv(t0, u) + (tv(t1, u) - tv(t0, u)) * j / nt
+            p, c = F(u, t); pu = F(u + 1e-3, t)[0]; pt = F(u, t + 1e-3)[0]
+            du = [a - b for a, b in zip(pu, p)]; dt = [a - b for a, b in zip(pt, p)]
+            n = [du[1] * dt[2] - du[2] * dt[1], du[2] * dt[0] - du[0] * dt[2], du[0] * dt[1] - du[1] * dt[0]]
