+def mesh_obj(name, verts, faces, mat, uvs=None, smooth=False):
+    me = bpy.data.meshes.new(name); me.from_pydata([g2b(*v) for v in verts], [], faces)
+    if uvs is not None:
+        me.uv_layers.new(); ul = me.uv_layers[0].data; k = 0
