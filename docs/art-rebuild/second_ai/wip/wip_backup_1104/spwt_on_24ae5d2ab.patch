+        s = int(sz * rnd.uniform(0.92, 1.06)); d.text((x + rnd.uniform(-1, 1), y + rnd.uniform(-2, 2)), ch, font=f(s), fill=col)
+        x += s * (1.0 if ord(ch) > 255 else 0.58)
+
