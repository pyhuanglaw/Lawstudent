+    c = L['carts']; r(c['x0'], c['x1'], c['z0'], c['z1'], 'carts')
+    for t in L['seasonal']: r(t['x'] - t['w'] / 2, t['x'] + t['w'] / 2, t['z'] - t['d'] / 2, t['z'] + t['d'] / 2, t['kind'])
+    for t in L['produce_tables']: r(t['x'] - t['w'] / 2, t['x'] + t['w'] / 2, t['z'] - t['d'] / 2, t['z'] + t['d'] / 2, 'produce table')
