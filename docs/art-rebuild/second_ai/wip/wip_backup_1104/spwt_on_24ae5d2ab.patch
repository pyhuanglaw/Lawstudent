+def ridge(name, dist, h0, amp, col, seed, x0=-1400, x1=1400, n=220, side=1, z0=-18):
+    """遠山的稜線（幾個正弦波疊加）；dist＝沿 x 的距離（side＝−1 在左邊：面朝 +x）或沿 y"""
