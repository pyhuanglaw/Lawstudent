+# ---------------------------------------------------------------- 招牌、店內景深卡的字（GLB 的 SIGN_FACE_* 是空白板面）
+def sign_img(p, w_m, h_m):
+    W = 1024; H = max(64, round(W * h_m / max(w_m, 0.05)))
+    im = Image.new('RGB', (W, H), p.get('bg', '#3b2a1e')); d = ImageDraw.Draw(im); fg = p.get('color', '#f4ead8')
