+            ys = (0.95, 1.15, 1.35) if kind == 'seat' else (0.5, 0.9, 1.3, 1.65)   # 坐著：上半身和頭（下半身被桌子、椅背擋住是正常的）
+            body = [np.array([x + sx * o, y, z + sz * o]) for y in ys for o in (-0.18, 0.0, 0.18)]
