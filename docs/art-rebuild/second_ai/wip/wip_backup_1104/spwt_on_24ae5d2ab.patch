+def facade_rects(w, h, holes):
+    """立面 0～w × 0～h 扣掉洞（[(x0,x1,y0,y1)]）剩下的長方形（和 us_community 同一個做法）"""
+    xs = sorted(set([0.0, w] + [v for (a, b, _, _) in holes for v in (a, b)]))
+    out = []
+    for xa, xb in zip(xs, xs[1:]):
+        if xb - xa < 1e-4: continue
