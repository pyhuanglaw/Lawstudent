+L['produce_wall'] = {'x': X1 - 0.55, 'z0': -10.5, 'z1': 6.5, 'd': 1.1, 'note': '冷藏蔬菜（噴霧）：生菜、花椰菜、紅蘿蔔、香草'}
+# 中間八條雙面貨架（沿 z）
+GON = []
