+L['spawn'] = {'x': 13.5, 'z': 13.6, 'yaw': math.pi, 'note': '從入口自動門進來（面向北）'}
+L['exit'] = {'x': -13.5, 'z': 14.9, 'r': 1.2, 'label': '離開超市', 'to': 'us_outside'}
+# 前段（z 8～15）
+CHECK = []
