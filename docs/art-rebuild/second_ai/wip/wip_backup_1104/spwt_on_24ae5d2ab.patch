+TABLES = [{'x': x, 'z': -0.8, 'w': 1.1, 'd': 3.6, 'axis': 'z', 'chairs': 3, 'note': '中庭的長閱覽桌（淺木色、每邊三張椅子）'} for x in (-5.6, -2.6, 0.4, 3.4)]   # 東邊留 1.5 m 走道到樓梯
