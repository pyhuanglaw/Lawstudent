+def wall_pt(c, side, a, y, d):
+    """牆上的點：沿牆的位置 a（N／S 是 x、W／E 是 z）、高度 y、離牆 d（往室內）"""
+    return {'N': (a, y, c.Z0 + d), 'S': (a, y, c.Z1 - d), 'W': (c.X0 + d, y, a), 'E': (c.X1 - d, y, a)}[side]
+
