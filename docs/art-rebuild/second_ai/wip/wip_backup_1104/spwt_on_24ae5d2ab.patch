+def mat(name, col, rough=0.5, metal=0.0, emit=None, estr=1.0, trans=0.0, ior=1.45, coat=0.0, alpha=None):
+    m = bpy.data.materials.new(name); m.use_nodes = True; b = m.node_tree.nodes['Principled BSDF']
