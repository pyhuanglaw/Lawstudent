+    def tquad(self, pts, key, flip=False):
+        u0, v0, u1, v1 = uvr(key); f = self.bm.faces.new([self.bm.verts.new(g2b(*p)) for p in pts])
+        uvs = [(u0, v0), (u1, v0), (u1, v1), (u0, v1)]
+        if flip: uvs = [uvs[1], uvs[0], uvs[3], uvs[2]]
