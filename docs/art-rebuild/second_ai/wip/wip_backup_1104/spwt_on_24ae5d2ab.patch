+            for vi in f: ul[k].uv = uvs[vi]; k += 1
+    if smooth: me.polygons.foreach_set('use_smooth', [True] * len(me.polygons))
+    ob = bpy.data.objects.new(name, me); ob.data.materials.append(mat); sc.collection.objects.link(ob); return ob
