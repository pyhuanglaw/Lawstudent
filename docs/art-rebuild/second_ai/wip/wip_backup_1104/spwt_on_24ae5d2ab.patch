+def book_box(s, x, z, rot=0.0, w=0.42, d_=0.32, h=0.24):
+    """紙箱（四面＋底、翻開的蓋子）裡立著一排一排的書（書背朝上）"""
+    ca, sa = math.cos(rot), math.sin(rot)
