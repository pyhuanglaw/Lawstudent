+for cx, w, y0, y1 in ((0.0, 2.6, 0.0, 2.7), (-3.0, 2.8, 0.9, 3.1), (3.0, 2.8, 0.9, 3.1)):
+    me = bpy.data.meshes.new('view'); z = 4.5 + 0.35
+    me.from_pydata([g2b(cx + w / 2, y0, z), g2b(cx - w / 2, y0, z), g2b(cx - w / 2, y1, z), g2b(cx + w / 2, y1, z)], [], [(0, 1, 2, 3)])
