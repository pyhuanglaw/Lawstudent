+     'checkout': {'x0': -6.4, 'x1': -2.6, 'z0': 3.2, 'z1': 4.0, 'note': '結帳櫃台（收銀機、刷卡機、小零食架）；收銀員站北邊；後牆上紅燈籠、月曆'},
+     'promo_rice': {'x0': 6.0, 'x1': 7.4, 'z0': 2.6, 'z1': 4.2, 'note': '門口東邊：一棧板促銷的米（紙板價格牌，沒有字）'},
