+def face_quad(mesh, cx, cy, cz, w, h, yaw, uvs, off=0.0):
+    """直立的板子（中心 cx,cy,cz、寬 w、高 h），面向 (sin yaw, cos yaw)；off＝往面向的方向推出去"""
