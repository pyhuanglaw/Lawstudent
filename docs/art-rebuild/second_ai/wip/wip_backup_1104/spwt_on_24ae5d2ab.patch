+# ---------------------------------------------------------------- 材質小工具
+def mat_flat(name, col, rough=0.7, emit=None, estr=0.0, metal=0.0):
+    mt = bpy.data.materials.new(name); mt.use_nodes = True; b = mt.node_tree.nodes['Principled BSDF']
