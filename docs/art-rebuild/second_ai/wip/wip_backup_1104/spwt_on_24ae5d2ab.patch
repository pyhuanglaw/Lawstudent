+class Goods:
+    def __init__(self, name, mat, lod=0):
+        """lod=1：隔著店面玻璃遠看用的低面數（瓶罐六邊、少幾圈，袋子少幾格；2026-10-23 公館、118 巷店面，一條街幾百瓶）"""
