+class TMesh(Mesh):
+    """貼圖集的網格：每個面指定貼圖集裡的一塊（同 dorm_y3_items.py）"""
+    def __init__(self, name, mat):
+        super().__init__(name, mat); self.uv = self.bm.loops.layers.uv.new('UVMap')
