+            for j in range(8): d.ellipse([cx + 30 + j * 58, cy + 130, cx + 80 + j * 58, cy + 160], fill=rr.choice([(200, 120, 60), (230, 200, 120), (120, 160, 80), (220, 90, 60)]))
