+        print(f'  {c:5d}  {key[0]} / {key[1]}  坐著 {seats}  例 {e[0]}')
+    print('  坐著被擋（位置、方向 k×45°、遮住比例、材質）：', seatbad[:14], '…' if len(seatbad) > 14 else '')
+
