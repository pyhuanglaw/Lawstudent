+    else: pts = [(cx + w / 2, cy - h / 2, Z1 - off), (cx - w / 2, cy - h / 2, Z1 - off), (cx - w / 2, cy + h / 2, Z1 - off), (cx + w / 2, cy + h / 2, Z1 - off)]
