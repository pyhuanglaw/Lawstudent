+
+
+def in_area(x, z, m=0.0):
+    return any(a['x0'] + m <= x <= a['x1'] - m and a['z0'] + m <= z <= a['z1'] - m for a in AREAS)
+
+
+def build():
+    rnd = random.Random(SEED); trees = []
+    # 第三版（BB_248 末節第 1 點：65 棵像同一棵、排成等距的一排排）：泊松圓盤（每棵自己的最小間距 2.8～4.6 m、試很多次隨機點），
