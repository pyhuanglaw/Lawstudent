+def _fit(asp, W=CELL, H=112, pad=2):
+    """在 W×H 裡放一個長寬比 asp 的最大矩形（置中）"""
+    W2, H2 = W - 2 * pad, H - 2 * pad
+    if W2 / H2 > asp: w, h = H2 * asp, H2
+    else: w, h = W2, W2 / asp
+    return (W - w) / 2, (H - h) / 2, (W + w) / 2, (H + h) / 2
