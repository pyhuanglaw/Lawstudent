+            if Rb is None or Rb[0] - xb > 0.002 or h > Rb[2] + 0.003: face([(xb, 0, 0), (xb, 0, -d), (xb, h, -d), (xb, h, 0)], [(us[0], v0), (us[1], v0), (us[1], v1), (us[0], v1)])
+        if bookend and runs:
