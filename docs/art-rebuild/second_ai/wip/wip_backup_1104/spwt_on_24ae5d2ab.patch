+PATHS = [{'id': 'w1', 'w': 1.2, 'pts': [[44.0, -84.6], [43.0, -77.0], [39.5, -71.0], [35.2, -67.0]]},
+         {'id': 'w2', 'w': 1.2, 'pts': [[67.0, -72.5], [60.0, -71.5], [52.0, -69.5], [46.5, -65.0]]},
