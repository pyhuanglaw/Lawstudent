+        segs = [b0] + [v for g in sorted(gaps) for v in g] + [b1]
+        for k in range(0, len(segs), 2): (wl.box(segs[k], segs[k + 1], 2.68, H, at - 0.05, at + 0.05) if axis == 'x' else wl.box(at - 0.05, at + 0.05, 2.68, H, segs[k], segs[k + 1]))
