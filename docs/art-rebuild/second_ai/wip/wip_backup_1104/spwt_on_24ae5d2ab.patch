+def patch(part, F, u0, u1, t0, t1, nu=2, nt=2, off=0.003):
+    """在車殼曲面上取一塊（u0～u1、t0～t1；t 可以是 u 的函式），沿法線往外推 off：燈和方向燈貼著車殼的曲面，不是貼在表面的小方塊"""
