+def spin(verts, cx, cz, a):
+    """頂點繞 (cx, cz) 的鉛直軸轉 a（遊戲座標）"""
+    for v in verts:
+        x, yv, z = v.co.x, v.co.z, -v.co.y; dxz = roty((x - cx, 0, z - cz), a); v.co = g2b(cx + dxz[0], yv, cz + dxz[2])
