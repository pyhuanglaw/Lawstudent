+        rbox(c.vc, T, -0.2, 0.2, 0.7, 0.84, -0.205, -0.175, col, r=0.008, seg=1); rbox(c.vc, T, -0.18, 0.18, 0.55, 0.6, -0.2, -0.18, col)
