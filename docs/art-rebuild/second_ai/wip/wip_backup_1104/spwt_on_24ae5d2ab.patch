+                   {'text': 'MEAT', 'x': -9.2, 'z': Z0 + 0.05, 'y': 4.3, 'face': 'S'}, {'text': 'BAKERY · DELI', 'x': -18.0, 'z': Z0 + 0.05, 'y': 4.3, 'face': 'S'},
