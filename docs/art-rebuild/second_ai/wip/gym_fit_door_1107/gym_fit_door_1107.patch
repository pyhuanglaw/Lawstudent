+const hit=(o,dz)=>{ const out=[]; const D=[0,0,dz]; for(const m of meshes){ for(let t=0;t<m.I.length;t+=3){ const a=m.P[m.I[t]], b=m.P[m.I[t+1]], c=m.P[m.I[t+2]];
