+    const a=s.P[s.I[0]], c=s.P[s.I[1]], d=s.P[s.I[2]], u=[c[0]-a[0],c[1]-a[1],c[2]-a[2]], v=[d[0]-a[0],d[1]-a[1],d[2]-a[2]], nz=u[0]*v[1]-u[1]*v[0];
