+def bulb(s, x, y, z, drop=0.16, r=0.05, cap=BLACK, shade=None):
+    s.box(x - 0.004, x + 0.004, y - drop, y, z - 0.004, z + 0.004, BLACK); s.cyl((x, y - drop - 0.04, z), (x, y - drop, z), 0.022, cap, seg=6)
