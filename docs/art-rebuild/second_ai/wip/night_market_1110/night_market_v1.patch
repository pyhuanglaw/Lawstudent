+    else: s.box(z, z + 0.025, cy - h / 2 - 0.02, cy + h / 2 + 0.02, x - w / 2 - 0.02, x + w / 2 + 0.02, col); s.tq(key, x, cy, w, z - 0.004, face='-x')
