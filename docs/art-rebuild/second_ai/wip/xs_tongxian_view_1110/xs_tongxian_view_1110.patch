+      try{ asked.length=0; z.applyTime(14,'clear'); mDay=asked.slice(); asked.length=0; z.applyTime(21,'clear'); mNight=asked.slice(); }catch(err){ ok=false; console.log(err.stack); } W3.viewPhoto=vp0;
