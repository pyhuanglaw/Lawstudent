+bpy.ops.import_scene.gltf(filepath=GLB)
+sc = bpy.context.scene; sc.render.engine = 'CYCLES'; sc.cycles.device = 'CPU'; sc.cycles.samples = samples; sc.cycles.max_bounces = 4
