+  "alleys": [{"id": "A", "side": "E", "z0": -2.5, "z1": 2.5, "len": 24, "walk": true, "night": true, "to": "gongguan", "note": "從公館店面街 G10 的巷口過來（羅斯福路和汀州路之間的南北向小巷，地圖 1 的夜市巷）；晚上兩側擺攤"}],
+  "shops": [
