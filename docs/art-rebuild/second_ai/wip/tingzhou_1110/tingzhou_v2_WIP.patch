+"""汀州路三間有規格的店的招牌（TINGZHOU-AREA-1110 第 2 版；使用者規格 docs/handoff/user_specs/GG_SHOPS3_1110.md 第三節 3～5）→ textures/gen/tz_signs_atlas.{jpg,json}
+招牌是平面設計（底色、店名、線條圖示），照規格的顏色和圖示畫；不是材質貼圖。格式同 sign_atlas.py（uv、aspect、lit、part），wz_shopkit 的 SIGN_ATLAS 讀。
+  洗樂洗衣坊：淺天藍燈箱、白色圓體字、滾筒洗衣機線條圖示
+  印得好：深灰藍燈箱、白字、紙張與印表機圖示
+  泰米村食：米白招牌、深木色字、暖橘；米飯、香料葉片、餐盤圖示
+用法：python3 tools/blender/env_second/tz_signs_tex.py"""
+import os, json, math
+from PIL import Image, ImageDraw, ImageFont
+HERE = os.path.dirname(os.path.abspath(__file__)); GEN = os.path.join(HERE, 'textures', 'gen')
+FONT = '/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc'
+S = 2   # 超取樣
+
+
+def F(px): return ImageFont.truetype(FONT, int(px * S))
+
+
+def washer(d, cx, cy, r, col, w):
+    """滾筒洗衣機（線條）：圓角機身、圓門、門裡的水波、上面兩個旋鈕"""
+    d.rounded_rectangle([cx - r, cy - r * 1.15, cx + r, cy + r * 1.15], radius=r * 0.22, outline=col, width=w)
+    d.line([cx - r, cy - r * 0.62, cx + r, cy - r * 0.62], fill=col, width=w)
+    for k in (-0.55, -0.2): d.ellipse([cx + k * r - r * 0.09, cy - r * 0.97, cx + k * r + r * 0.09, cy - r * 0.79], fill=col)
+    d.ellipse([cx - r * 0.62, cy - r * 0.38, cx + r * 0.62, cy + r * 0.86], outline=col, width=w)
+    pts = [(cx - r * 0.42 + i * r * 0.84 / 12, cy + r * 0.3 + math.sin(i / 12 * math.pi * 2) * r * 0.09) for i in range(13)]
+    d.line(pts, fill=col, width=w)
+
+
+def printer(d, cx, cy, r, col, w):
+    """印表機＋紙張（線條）：機身、上面進紙的一張紙（三條字）、下面出紙"""
+    d.rounded_rectangle([cx - r, cy - r * 0.3, cx + r, cy + r * 0.55], radius=r * 0.12, outline=col, width=w)
+    d.rectangle([cx - r * 0.55, cy - r * 1.1, cx + r * 0.55, cy - r * 0.3], outline=col, width=w)
+    for k in (-0.9, -0.7, -0.5): d.line([cx - r * 0.35, cy + k * r, cx + r * 0.35, cy + k * r], fill=col, width=max(1, w // 2))
+    d.rectangle([cx - r * 0.6, cy + r * 0.25, cx + r * 0.6, cy + r * 1.05], outline=col, width=w)
+    d.ellipse([cx + r * 0.62, cy - r * 0.12, cx + r * 0.8, cy + r * 0.06], fill=col)
+
+
+def plate(d, cx, cy, r, col, acc, w):
+    """餐盤上一座米飯、旁邊一片香料葉（線條＋暖橘）"""
+    d.ellipse([cx - r, cy + r * 0.25, cx + r, cy + r * 0.8], outline=col, width=w)
+    d.pieslice([cx - r * 0.6, cy - r * 0.55, cx + r * 0.6, cy + r * 0.95], 180, 360, outline=col, width=w)
+    for (a, b) in ((-0.25, -0.05), (0.1, -0.2), (0.3, 0.05), (-0.05, 0.12)): d.line([cx + a * r, cy + b * r, cx + (a + 0.12) * r, cy + (b - 0.05) * r], fill=col, width=max(1, w // 2))
+    lx, ly = cx + r * 0.75, cy - r * 0.55   # 葉子
+    d.chord([lx - r * 0.42, ly - r * 0.2, lx + r * 0.42, ly + r * 0.2], 0, 360, fill=acc)
+    d.line([lx - r * 0.42, ly, lx + r * 0.42, ly], fill='#fff6e6', width=max(1, w // 2))
+
+
+def fit(d, t, wmax, px):
+    while px > 10:
+        f = F(px); b = d.textbbox((0, 0), t, font=f)
+        if b[2] - b[0] <= wmax * S: return f, b
+        px -= 2
+    return f, b
+
+
+def hsign(w, h, bg, fg, name, sub, icon, acc=None, band=None):
+    im = Image.new('RGB', (w * S, h * S), bg); d = ImageDraw.Draw(im); lw = max(2, int(h * S * 0.028))
+    if band: d.rectangle([0, int(h * S * 0.9), w * S, h * S], fill=band)
+    r = h * S * 0.3; cx = h * S * 0.62; cy = h * S * 0.47
+    icon(d, cx, cy, r, fg, lw) if acc is None else icon(d, cx, cy, r, fg, acc, lw)
+    x0 = h * S * 1.2; f, b = fit(d, name, w - h * 1.2 - (h * 0.2), h * 0.56)
+    tw = b[2] - b[0]; tx = x0 + ((w * S - x0 - h * S * 0.2) - tw) / 2
+    d.text((tx - b[0], h * S * (0.4 if sub else 0.47) - (b[1] + b[3]) / 2), name, font=f, fill=fg)
+    if sub:
+        fs, bs = fit(d, sub, w - h * 1.4, h * 0.15); d.text((x0 + ((w * S - x0 - h * S * 0.2) - (bs[2] - bs[0])) / 2 - bs[0], h * S * 0.76 - (bs[1] + bs[3]) / 2), sub, font=fs, fill=acc or fg)
+    return im.resize((w, h), Image.LANCZOS)
+
+
+def vsign(w, h, bg, fg, name, icon, acc=None, band=None):
+    im = Image.new('RGB', (w * S, h * S), bg); d = ImageDraw.Draw(im); lw = max(2, int(w * S * 0.03))
+    if band: d.rectangle([0, 0, w * S, int(w * S * 0.12)], fill=band); d.rectangle([0, h * S - int(w * S * 0.12), w * S, h * S], fill=band)
+    r = w * S * 0.27; icon(d, w * S / 2, w * S * 0.62, r, fg, lw) if acc is None else icon(d, w * S / 2, w * S * 0.62, r, fg, acc, lw)
+    y0 = w * S * 1.15; ch = list(name); step = (h * S - y0 - w * S * 0.25) / len(ch); f = F(min(w * 0.66, step / S * 0.86))
+    for i, c in enumerate(ch):
+        b = d.textbbox((0, 0), c, font=f); d.text((w * S / 2 - (b[0] + b[2]) / 2, y0 + (i + 0.5) * step - (b[1] + b[3]) / 2), c, font=f, fill=fg)
+    return im.resize((w, h), Image.LANCZOS)
+
+
+def main():
+    HW, HH, VW, VH = 1000, 124, 148, 520   # 橫 8.06：1（板面 0.72 m 高 → 5.8 m 寬）、直 0.74×2.6 m
+    items = [('tz_xile_h', hsign(HW, HH, '#7cc4ea', '#ffffff', '洗樂洗衣坊', '投幣洗衣・烘衣', washer)),
+             ('tz_yindehao_h', hsign(HW, HH, '#2f4256', '#ffffff', '印得好', '影印・列印・裝訂・輸出', printer)),
+             ('tz_taimi_h', hsign(HW, HH, '#f2e8d6', '#4a2f1c', '泰米村食', '泰式家常料理', plate, acc='#d9772e', band='#d9772e')),
+             ('tz_xile_v', vsign(VW, VH, '#7cc4ea', '#ffffff', '洗樂洗衣坊', washer)),
+             ('tz_yindehao_v', vsign(VW, VH, '#2f4256', '#ffffff', '印得好', printer)),
+             ('tz_taimi_v', vsign(VW, VH, '#f2e8d6', '#4a2f1c', '泰米村食', plate, acc='#d9772e', band='#d9772e'))]
+    W = H = 1024; atlas = Image.new('RGB', (W, H), (40, 40, 40)); info = {}; P = 4; y = P
+    for k, im in items[:3]:
+        atlas.paste(im, (P, y)); info[k] = dict(uv=[P / W, 1 - (y + im.height) / H, (P + im.width) / W, 1 - y / H], aspect=round(im.width / im.height, 4), lit=True, part='h'); y += im.height + P
+    x = P
+    for k, im in items[3:]:
+        atlas.paste(im, (x, y)); info[k] = dict(uv=[x / W, 1 - (y + im.height) / H, (x + im.width) / W, 1 - y / H], aspect=round(im.width / im.height, 4), lit=True, part='v'); x += im.width + P
+    os.makedirs(GEN, exist_ok=True); atlas.save(os.path.join(GEN, 'tz_signs_atlas.jpg'), quality=92); json.dump(info, open(os.path.join(GEN, 'tz_signs_atlas.json'), 'w'), indent=1); print('saved', list(info))
+
+
+if __name__ == '__main__':
+    main()
