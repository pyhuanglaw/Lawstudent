diff --git a/tests/rooms_ab3_lm_unit.js b/tests/rooms_ab3_lm_unit.js
new file mode 100644
index 000000000..bdf21058a
--- /dev/null
+++ b/tests/rooms_ab3_lm_unit.js
@@ -0,0 +1,30 @@
+// AA_399 那一批走得進去的房間的光照烘焙（INTERIOR-AAA-REVIEW-1028 P1；LAWWW2-B 2026-11-07；tools/blender/env_second/lightbake/bake_rooms_ab3.sh）——不需要瀏覽器。
+//   共同 3F、霖澤辦公室、博雅 203、宿舍洗衣間、總圖視聽室（rooms_glb3d.js 的房間；遊戲用 Z3.attachRoomGLB，GLB 有 extras.lightmap 就接，不用改程式）。
+//   1. 每間的 GLB 有 extras.lightmap，白天、晚上的貼圖檔都在
+//   2. 地板、天花板、牆、收邊條有第二套 UV（烘焙）；燈管、發光的東西、頂點色的小東西、金屬件、玻璃、信件格沒有（照舊即時光）
+//   3. 沒有材質同時給「有第二套 UV」和「沒有」的網格用（遊戲把光照貼圖接在材質上，沒有第二套 UV 的網格會讀到錯的地方）
+//   4. 淡出的牆節點都在（WALL_N／E／S／W）
+//   5. rooms_glb3d.js 照舊用 Z3.attachRoomGLB 接正式模型
+// 修改前：GLB 沒有 extras.lightmap（第 1 項失敗）。用法：node tests/rooms_ab3_lm_unit.js
+const fs=require('fs'), path=require('path');
+const ROOT=path.resolve(__dirname,'..');
+let fails=0; const check=(name,ok,info)=>{ console.log((ok?'PASS ':'FAIL ')+name+(info?'　'+info:'')); if(!ok) fails++; };
+const ROOMS=['gongtong_3f','linze_office','boya_203','dorm_laundry','library_media'];
+const exists=u=>!!u&&fs.existsSync(path.join(ROOT,u));
+const BAKE=/(_floorm|_ceiling|^WALL_[NESW]_(wall|wain|trim))$/, LIVE=/(_tubes|_screens|_lamps|_display|_props|_metal|glass|pigeonvc)/;
+for(const id of ROOMS){ const buf=fs.readFileSync(path.join(ROOT,'assets/models/env/second_ai/'+id+'.glb')), J=JSON.parse(buf.slice(20,20+buf.readUInt32LE(12)).toString('utf8'));
+  const l=((J.scenes[0].extras||{}).lightmap)||null;
+  check('1. '+id+'：extras.lightmap 白天、晚上的貼圖都在', !!l&&exists(l.day)&&exists(l.night)&&l.intensity>0, l?l.day:'沒有');
+  if(!l) continue;
+  const ms=J.nodes.filter(n=>n.mesh!=null).map(n=>({name:n.name, prims:J.meshes[n.mesh].primitives.map(p=>({uv1:p.attributes.TEXCOORD_1!=null, mat:p.material!=null?J.materials[p.material].name:null}))}));
+  const bake=ms.filter(m=>BAKE.test(m.name)), noUV=bake.filter(m=>!m.prims.every(p=>p.uv1)).map(m=>m.name);
+  check('2. '+id+'：地板、天花板、牆、收邊條有第二套 UV（'+bake.length+' 個）', bake.length>=8&&!noUV.length, noUV.join('、'));
+  const live=ms.filter(m=>LIVE.test(m.name)), bad=live.filter(m=>m.prims.some(p=>p.uv1)).map(m=>m.name);
+  check('2. '+id+'：燈管、發光、小東西、金屬件、玻璃沒有第二套 UV（'+live.length+' 個）', live.length>=3&&!bad.length, bad.join('、'));
+  const w=new Set(), wo=new Set(); for(const m of ms) for(const p of m.prims) (p.uv1?w:wo).add(p.mat); const both=[...w].filter(x=>wo.has(x));
+  check('3. '+id+'：沒有材質同時給有／沒有第二套 UV 的網格', !both.length, both.join('、'));
+  const names=new Set(J.nodes.map(n=>n.name)), miss=['WALL_N_wall','WALL_E_wall','WALL_S_wall','WALL_W_wall'].filter(n=>!names.has(n));
+  check('4. '+id+'：淡出的牆節點都在', !miss.length, miss.join('、')); }
+const src=fs.readFileSync(path.join(ROOT,'src/rooms_glb3d.js'),'utf8');
+check('5. rooms_glb3d.js 照舊用 Z3.attachRoomGLB', /Z3\.attachRoomGLB\(z,g0,fb,root\)/.test(src));
+console.log(fails?'FAILED '+fails:'ALL PASS'); process.exit(fails?1:0);
