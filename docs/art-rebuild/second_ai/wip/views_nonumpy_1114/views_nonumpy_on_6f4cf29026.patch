     B = np.asarray(b).astype(np.float32) / 255; W = np.asarray(w).astype(np.float32) / 255
     a = np.clip(1.0 - (W - B).mean(axis=2), 0.0, 1.0)
     a = np.where(a < 0.02, 0.0, a)                                     # 雜訊當成全透明
