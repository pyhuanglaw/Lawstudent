+    nav1.fillBlocked(); nav1.freeRect(U.x0+0.35,U.z0+0.35,WL.x0-0.25,U.railZ-0.3);                   // 教室（東邊到樓梯開口的欄杆、南邊到玻璃欄杆）
+    nav1.freeRect(LD.x0-0.3,LD.z0+0.15,LD.x1-0.25,LD.z1);                                            // 樓梯平台（連到教室）
