+    nav0.blockRect((T.x0+T.x1)/2,(-D/2+T.zTop)/2,T.x1-T.x0+0.2,T.zTop+D/2,0);                        // 樓梯頂端後面（平台底下，一樓是儲藏間）
+    nav0.blockRect((T.x0+T.x1)/2,T.zTop+0.2,T.x1-T.x0,0.4,0);                                        // 最上面那一排在第 0 層擋住
