+
+  // ---- 樓梯的高度（往 −z 爬）：連續斜面給碰撞與找路，畫面上一階一階 ----
+  S.stairSurfs=function(L){ const T=L.stair, Y1=L.floors[1].y, t=T.tread;
+    const run={x0:T.x0,x1:T.x1,z0:T.zTop+t/2,z1:T.zBottom,axis:'z',ya:Y1,yb:0,tread:t,rise:T.rise,low:'z1'};
