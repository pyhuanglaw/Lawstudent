+def goods(x0, x1, y, z0, z1, cols, hmin=0.1, hmax=0.22, along='z', step=0.11, depth=None):
+    """一層貨架上的一排盒子、瓶子（沿 z 或沿 x 排；每個顏色高度不一樣）"""
+    a0, a1 = (z0, z1) if along == 'z' else (x0, x1); a = a0 + 0.02
