+            goods(x0, xm - 0.02, y, z0 + 0.05, z1 - 0.05, cols_by_level[i % len(cols_by_level)]); goods(xm + 0.02, x1, y, z0 + 0.05, z1 - 0.05, cols_by_level[(i + 1) % len(cols_by_level)])
