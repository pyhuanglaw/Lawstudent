+for k in range(4): ccyl(VC, (ub['x0'] + 0.1 + k * 0.1, 0.05, (ub['z0'] + ub['z1']) / 2), (ub['x0'] + 0.07 + k * 0.11, 0.95, (ub['z0'] + ub['z1']) / 2 + 0.02), 0.03, R.choice(['#1e2a3a', '#e8e8e4', '#3a5a3a']), seg=6, r2=0.012)
+
+# ================= 窗外（只給渲染用） =================
+if PREVIEW:
+    om = img_mat('PREVIEW_outside', P['outside'], rough=1.0, emit=0.75); ob_ = Mesh('PREVIEW_outside', om)
+    face(ob_, (-2.0, 2.6, Z1 + 6.0), '-z', 22, 8.2, (0, 0, 1, 1)); ob_.finish(root, uv=False)
+
+# ================= 收尾：牆分組、合併、匯出 =================
+for (side, key), m in list(WG.items()): m.finish(G[side], uv=(key == 'vm'), smooth=False)
+VC.finish(root, uv=True); VM.finish(root, uv=True, smooth=True)   # 頂點色 × 材質組：要盒狀 UV
+WD.finish(root, uv=True)
+for m, pr in ((PR, None), (GD, None), (DEC, None), (COOL, None), (SCR, None), (LED, None), (GLS, {'glass': 1}), (GLSF, {'glass': 1, 'side': 'front'}), (DECF, {'side': 'front'})): m.finish(root, uv=(m is LED), props=pr)
+for ob in list(root.children_recursive):
+    if ob.type == 'MESH' and ob.data and len(ob.data.polygons) == 0: B.remove(ob)
+CK.drop_protos()
+L.merge_by_material(root, keep=lambda ob: ob.name.startswith(('WALL_', 'PREVIEW', 'GLASS_', 'DECAL_', 'S_ph_')), key=lambda ob: '')
+st_ = L.export(OUT)
+mats = sorted({ms.material.name for ob in bpy.data.objects if ob.type == 'MESH' for ms in ob.material_slots if ms.material})
+print('OK', OUT, 'materials', len(mats), mats); print('CC0_USED', CK.used())
diff --git a/tools/blender/env_second/cc0_kit.py b/tools/blender/env_second/cc0_kit.py
index 680fb20f6a..9e16f2884c 100644
--- a/tools/blender/env_second/cc0_kit.py
+++ b/tools/blender/env_second/cc0_kit.py
@@ -215,6 +215,19 @@ class Kit:
         try: return L.pbr(name, pid, maps=maps, res=res, **kw)
         finally: L.tex_dir = old
 
+    def vc_tex(self, name, aid, vary=0.06, tile=0.5, rough_value=0.55, metal=0.0, layer='Col', **kw):
+        """頂點色 × ambientCG 材質組（SHOP-CC0-HELP-1113，幫手 g2）：顏色照舊來自頂點色（每個零件原本的顏色），
+        乘上校成近白色的材質組顏色貼圖（紋路、明暗起伏）＋法線——一個材質就讓整群頂點色零件有 CC0 的質感，不用一色一個材質。
+        glTF：baseColorTexture＋COLOR_0（three.js 兩個相乘）。網格要有 UV（Mesh.finish(uv=True) 的盒狀 UV）。"""
+        m = self.acg(name, aid, target='#f2f2f2', vary=vary, tile=tile, rough_value=rough_value, metal=metal, **kw)
+        nt = m.node_tree; N = nt.nodes; b = N['Principled BSDF']; ln = b.inputs['Base Color'].links
+        src = ln[0].from_socket if ln else None
+        vc = N.new('ShaderNodeVertexColor'); vc.layer_name = layer
+        mx = N.new('ShaderNodeMix'); mx.data_type = 'RGBA'; mx.blend_type = 'MULTIPLY'; mx.inputs['Factor'].default_value = 1.0
+        if src is not None: nt.links.new(src, mx.inputs[6])
+        nt.links.new(vc.outputs['Color'], mx.inputs[7]); nt.links.new(mx.outputs[2], b.inputs['Base Color'])
+        m['vc_tex'] = 1; return m
+
     def printed(self, name, pid, draw, weave, size=512, amp=0.44, **kw):
         """自製圖案（沒有字）：draw(PIL.ImageDraw, size) 畫圖案，乘上 ambientCG 材質（weave）的明暗紋路"""
         _free_name(name)
