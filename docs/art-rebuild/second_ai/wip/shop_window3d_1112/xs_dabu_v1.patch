+
+def xs_inside3d(spec, c, xf0, gx0, gx1, gy1, z, fr):
+    """新生南路一間店玻璃後面的立體店內（XS_DI 深）。xf0＝這一棟的座標；店內座標＝玻璃的中心是 x 0。回傳 True＝做了（xs_front 不再放景深卡）"""
+    cfg = XS_IN3D.get(spec.get('lane118'))
