+    global DI; _di = DI; DI = XS_DI
+    try: _shade_interior(cm, xf, iw, gz, yt, cfg.get('bright', 0.86), cfg.get('warm', False))
+    finally: DI = _di
+    cm.finish(root, uv=False)
+    return True
