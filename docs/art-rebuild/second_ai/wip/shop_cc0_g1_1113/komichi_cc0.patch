+            pts = [(q1[0], y0 + lo + 0.02, q1[1]), (q0[0], y0 + lo + 0.02, q0[1]), (q0[0], y0 + hi - 0.03, q0[1]), (q1[0], y0 + hi - 0.03, q1[1])]
