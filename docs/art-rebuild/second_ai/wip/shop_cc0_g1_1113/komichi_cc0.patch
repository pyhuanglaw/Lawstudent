+
+    def _wp(s, side, along, d):
+        """牆上一點（沿著牆 along、離內面 d，正＝往室內）→ (x, z)"""
+        if side == 'back': return (along, s.Z0 + d)
+        if side == 'front': return (along, s.Z1 - d)
+        if side == 'left': return (s.X0 + d, along)
