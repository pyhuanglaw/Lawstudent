+except Exception: pass
+sc.render.resolution_x, sc.render.resolution_y = RW, RH; sc.view_settings.view_transform = 'AgX'; sc.cycles.max_bounces = 6
+sc.view_settings.exposure = float(opt('--exposure', '0'))
