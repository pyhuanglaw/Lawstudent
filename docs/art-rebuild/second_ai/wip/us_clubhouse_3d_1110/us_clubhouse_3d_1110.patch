+  function buildNav(L){ const B=L.bounds, T=L.wallT, nav=new E3.NavGrid(B.x1-B.x0+0.6,B.z1-B.z0+0.6,0.2,B.x0-0.3,B.z0-0.3); nav.fillBlocked();
