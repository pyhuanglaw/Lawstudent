+_n0 = {}
+def _wrap(meth):
+    def f(self, *a, **k):
+        _n0[id(self)] = len(self.bm.faces); return meth(self, *a, **k)
+    return f
+for _nm in ('cyl', 'sphere', 'ell'): setattr(CMesh, _nm, _wrap(getattr(Mesh, _nm)))
