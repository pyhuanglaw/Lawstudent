+      else if(t==='vending') rect(f.x-f.d/2,f.x+f.d/2,f.z-f.w/2,f.z+f.w/2);
+      else if(t==='longTables') rect(f.navX0,f.navX1,f.z-f.d/2,f.z+f.d/2);
+      else if(t==='studyTable') rect(f.x-f.w/2,f.x+f.w/2,f.z-f.d/2,f.z+f.d/2);
