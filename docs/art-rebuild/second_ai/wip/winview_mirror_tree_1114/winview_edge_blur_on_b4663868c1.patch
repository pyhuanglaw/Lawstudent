--- a/src/world3d.js
+++ b/src/world3d.js
@@ -179,10 +179,15 @@ const W3 = (function(){
   function windowMat(depth){ return new THREE.ShaderMaterial({ uniforms:{ map:{value:null}, tint:{value:new THREE.Color(1,1,1)}, depth:{value:depth||20}, photo:{value:0}, sxy:{value:new THREE.Vector2(1,1)}, nmap:{value:null}, ndepth:{value:4}, near:{value:0}, map2:{value:null}, nmap2:{value:null}, near2:{value:0}, xf:{value:0} },
     vertexShader:'varying vec3 vP; varying vec3 vC; varying vec2 vUv; void main(){ vP=position; vUv=uv; vC=(inverse(modelMatrix)*vec4(cameraPosition,1.0)).xyz; gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.0); }',
     fragmentShader:'uniform sampler2D map; uniform sampler2D nmap; uniform sampler2D map2; uniform sampler2D nmap2; uniform vec3 tint; uniform float depth; uniform float ndepth; uniform float photo; uniform float near; uniform float near2; uniform float xf; uniform vec2 sxy; varying vec3 vP; varying vec3 vC; varying vec2 vUv;\n'+
-      'vec2 wvMirror(vec2 u){ u=1.0-abs(1.0-mod(u,2.0)); return clamp(u,vec2(0.002),vec2(0.998)); }\n'+   /* WINVIEW-EDGE-STRIPE-1114（BB_379）：照片外面原本 clamp 到邊上那一排像素（邊上有樹的時候拉成一條一條）→ 鏡像回來 */
-      'void main(){ vec2 uv=vUv; vec4 nc=vec4(0.0); vec4 n2=vec4(0.0); if(photo>0.5){ vec3 d=vP-vC; float t=(depth+vC.z)/max(0.001,vC.z); vec2 h=(vC.xy+d.xy*t)*sxy; uv=wvMirror(vec2(h.x/(2.0*depth)+0.5,h.y/depth+0.5));\n'+
+      /* 看到照片外面的時候（鏡頭抬高、往旁邊看）：
+           第一版 clamp 到邊上那一排像素——邊上有樹時拉成一條一條（WINVIEW-EDGE-STRIPE-1114，BB_379）；
+           第二版鏡像回來——邊上的樹變成左右／上下對稱的一團，半空一團沒有樹幹的樹葉、樹冠像萬花筒（WINVIEW-MIRROR-TREE-1114，BB-B 11-14 公館安泰、鮮果、榮恩典）；
+           現在：位置夾在邊上、但改取很模糊的那一層（mipmap 往上 7 層，1024×512 的照片剩 8×4 格）＝邊緣顏色柔和地往外延伸，沒有細節可以拉成條紋、也沒有東西可以對稱。
+           wvOut＝超出照片多少（uv）；超出 2.5% 以內由清楚漸漸變模糊，接縫看不出來。 */
+      'float wvOut(vec2 u){ vec2 o=max(-u,u-vec2(1.0)); return max(0.0,max(o.x,o.y)); }\n'+
+      'void main(){ vec2 uv=vUv; float wb=0.0; vec4 nc=vec4(0.0); vec4 n2=vec4(0.0); if(photo>0.5){ vec3 d=vP-vC; float t=(depth+vC.z)/max(0.001,vC.z); vec2 h=(vC.xy+d.xy*t)*sxy; vec2 ur=vec2(h.x/(2.0*depth)+0.5,h.y/depth+0.5); wb=clamp(wvOut(ur)*40.0,0.0,1.0)*7.0; uv=clamp(ur,vec2(0.002),vec2(0.998));\n'+
       '  if(near>0.5||near2>0.5){ float tn=(ndepth+vC.z)/max(0.001,vC.z); vec2 hn=(vC.xy+d.xy*tn)*sxy; vec2 un=vec2(hn.x/(2.0*ndepth)+0.5,hn.y/ndepth+0.5); if(un.x>0.002&&un.x<0.998&&un.y>0.002&&un.y<0.998){ if(near>0.5) nc=texture2D(nmap,un); if(near2>0.5) n2=texture2D(nmap2,un); } } }\n'+
-      ' vec4 c=texture2D(map,uv); vec3 col=mix(c.rgb,nc.rgb,nc.a)*tint; if(xf>0.0){ vec4 c2=texture2D(map2,uv); col=mix(col,mix(c2.rgb,n2.rgb,n2.a),xf); } gl_FragColor=vec4(col,1.0);\n #include <colorspace_fragment>\n}',
+      ' vec4 c=texture2D(map,uv,wb); vec3 col=mix(c.rgb,nc.rgb,nc.a)*tint; if(xf>0.0){ vec4 c2=texture2D(map2,uv,wb); col=mix(col,mix(c2.rgb,n2.rgb,n2.a),xf); } gl_FragColor=vec4(col,1.0);\n #include <colorspace_fragment>\n}',
     toneMapped:false, fog:false }); }
   // 換貼圖（白天／晚上、照片或退回的程序化貼圖）＋色調
   function setWindowView(m,kind,night,fallback,tint,xf){ const u=m.uniforms; if(!u) return; const ph=viewPhoto(kind,night); const want=ph||fallback; if(u.map.value!==want){ u.map.value=want; } u.photo.value=ph?1:0; if(tint!=null) u.tint.value.set(tint);
diff --git a/tests/winview_edge_mirror_1114_unit.js b/tests/winview_edge_mirror_1114_unit.js
index 86a599dacf..52b3524912 100644
--- a/tests/winview_edge_mirror_1114_unit.js
+++ b/tests/winview_edge_mirror_1114_unit.js
@@ -1,16 +1,23 @@
-// WINVIEW-EDGE-STRIPE-1114（BB_379，LAWWW2-C 11-14）：視差窗景（W3.windowMat）看到照片外面時，不能把邊上那一排像素拉長成條紋。
-// 原本 uv=clamp(...)：照片邊上有樹（GG-STREET-TREES 以後的公館窗景）時，鏡頭往上、往旁邊看就變成一條一條的直紋、橫紋。
-// 改成鏡像（wvMirror）：照片外面照鏡像取樣。這支不開瀏覽器：讀 world3d.js 的 shader 字串，用 JS 照同一個公式算幾個點。
+// 視差窗景（W3.windowMat）看到照片外面的時候怎麼畫——不開瀏覽器：讀 world3d.js 的 shader 字串，用 JS 照同一個公式算。
+// 第一版 uv=clamp(...)：邊上那一排像素拉長成條紋（WINVIEW-EDGE-STRIPE-1114，BB_379，LAWWW2-C 11-14）。
+// 第二版鏡像（wvMirror）：邊上有樹時變成左右／上下對稱的一團——公館安泰、鮮果半空一團沒有樹幹的對稱樹葉、榮恩典的樹像萬花筒
+//   （WINVIEW-MIRROR-TREE-1114，BB-B 11-14 PC GPU WINVIEW_GG3_dev @c109767aae 判 FAIL P2）。
+// 第三版（LAWWW2-B 11-14）：位置夾在邊上、改取很模糊的那一層（mipmap bias 7：1024×512 剩 8×4 格）——沒有細節可以拉成條紋，也沒有東西可以對稱。
 const fs=require('fs'), path=require('path');
 const src=fs.readFileSync(path.join(__dirname,'..','src','world3d.js'),'utf8');
 let fail=0; const check=(n,ok,msg)=>{ console.log((ok?'PASS ':'FAIL ')+n+'　'+(msg||'')); if(!ok) fail++; };
-check('1 windowMat 的照片 uv 不再 clamp 到邊上', !/uv=clamp\(vec2\(h\.x\/\(2\.0\*depth\)/.test(src), '');
-check('2 有 wvMirror、照片 uv 經過它', /vec2 wvMirror\(vec2 u\)\{ u=1\.0-abs\(1\.0-mod\(u,2\.0\)\);/.test(src) && /uv=wvMirror\(vec2\(h\.x\/\(2\.0\*depth\)\+0\.5,h\.y\/depth\+0\.5\)\)/.test(src));
-// 同一個公式（GLSL mod＝x−y·floor(x/y)）
-const mod=(x,y)=>x-y*Math.floor(x/y), clamp=(x,a,b)=>Math.min(b,Math.max(a,x)), m=u=>clamp(1-Math.abs(1-mod(u,2)),0.002,0.998);
-const near=(a,b)=>Math.abs(a-b)<1e-9;
-check('3 照片裡面（0～1）照舊', near(m(0.3),0.3)&&near(m(0.75),0.75));
-check('4 超出上緣 1.1 → 0.9（鏡像，不是 0.998 那一排）', near(m(1.1),0.9), 'm(1.1)='+m(1.1));
-check('5 超出左緣 −0.2 → 0.2', near(m(-0.2),0.2), 'm(-0.2)='+m(-0.2));
-check('6 往外越多取樣點就跟著變（不會整片同一排像素）', m(1.05)!==m(1.2) && m(-0.05)!==m(-0.3));
+const i0=src.indexOf('function windowMat('), sh=src.slice(i0,src.indexOf('toneMapped:false',i0)).split('\n').filter(l=>!/^\s*(\/\*|第|現在|wvOut＝)/.test(l)||/\'/.test(l)).join('\n');
+const code=sh.replace(/\/\*[\s\S]*?\*\//g,'');
+check('1 不鏡像：shader 裡沒有 wvMirror、沒有 mod(u,2.0)', !/wvMirror/.test(code) && !/mod\(u,2\.0\)/.test(code));
+check('2 照片外面：位置夾在邊上（clamp 0.002～0.998）', /uv=clamp\(ur,vec2\(0\.002\),vec2\(0\.998\)\)/.test(code));
+check('3 照片外面取模糊的那一層：兩張照片（白天、黃昏換的夜景）都帶 bias wb', /texture2D\(map,uv,wb\)/.test(code) && /texture2D\(map2,uv,wb\)/.test(code) && !/texture2D\(map,uv\)/.test(code) && !/texture2D\(map2,uv\)/.test(code));
+check('4 wb 照超出多少算：wvOut×40 夾到 0～1 再 ×7', /wb=clamp\(wvOut\(ur\)\*40\.0,0\.0,1\.0\)\*7\.0/.test(code) && /float wvOut\(vec2 u\)\{ vec2 o=max\(-u,u-vec2\(1\.0\)\); return max\(0\.0,max\(o\.x,o\.y\)\); \}/.test(code));
+// 同一個公式
+const out=(x,y)=>Math.max(0,Math.max(Math.max(-x,x-1),Math.max(-y,y-1))), wb=(x,y)=>Math.min(1,Math.max(0,out(x,y)*40))*7, cl=u=>Math.min(0.998,Math.max(0.002,u));
+check('5 照片裡面（0～1）：不模糊、位置照舊', wb(0.3,0.75)===0 && wb(0,1)===0 && cl(0.3)===0.3 && cl(0.75)===0.75);
+check('6 超出上緣 10%：夾在上緣、取最模糊的一層（7）', cl(1.1)===0.998 && wb(0.5,1.1)===7, 'wb='+wb(0.5,1.1));
+check('7 超出左緣 20%：夾在左緣、取最模糊的一層', cl(-0.2)===0.002 && wb(-0.2,0.5)===7);
+check('8 剛超出一點點（1%）：只模糊一點，接縫不會突然變', wb(0.5,1.01)>2 && wb(0.5,1.01)<4, 'wb='+wb(0.5,1.01).toFixed(2));
+check('9 超出上緣 10% 和 30% 取的是同一個位置（不鏡像：不會把照片裡面的樹再畫一次）', cl(1.1)===cl(1.3) && cl(-0.1)===cl(-0.3));
+check('10 窗景照片有 mipmap 可以取（viewPhoto 沒有關掉 generateMipmaps、沒有把 minFilter 改成不用 mipmap）', (()=>{ const a=src.indexOf('function viewPhoto('), f=src.slice(a,src.indexOf('function releaseViews',a)); return !/generateMipmaps\s*=\s*false/.test(f)&&!/minFilter\s*=\s*THREE\.(Linear|Nearest)Filter/.test(f); })());
 console.log(fail?('FAILED '+fail):'ALL PASS'); process.exit(fail?1:0);
