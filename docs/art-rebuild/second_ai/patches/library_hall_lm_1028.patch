+def _toB(rot):
+    """遊戲座標的旋轉（繞 x、y、z，依序）→ Blender 座標的旋轉矩陣"""
+    Pm = Matrix(((1, 0, 0), (0, 0, -1), (0, 1, 0)))
+    Rg = Matrix.Rotation(rot[2], 3, 'Z') @ Matrix.Rotation(rot[1], 3, 'Y') @ Matrix.Rotation(rot[0], 3, 'X')
+    return Pm @ Rg @ Pm.transposed()
