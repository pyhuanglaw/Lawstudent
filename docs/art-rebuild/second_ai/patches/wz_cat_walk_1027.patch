+    if(!E||!parent||!glb||!glb.scene||!(glb.animations&&glb.animations.length)||!S.awake(G)) return false;
+    if(typeof THREE_JSM==='undefined'||!THREE_JSM.SkeletonUtils||typeof Z3==='undefined'||!Z3.wzCatModel) return false;
