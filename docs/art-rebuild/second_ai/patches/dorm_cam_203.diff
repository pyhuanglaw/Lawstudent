+function hitBox(a,b,o){ let t0=0,t1=1; const lo=[o.x0+0.03,o.y0+0.03,o.z0+0.03], hi=[o.x1-0.03,o.y1-0.03,o.z1-0.03], A=[a.x,a.y,a.z], D=[b.x-a.x,b.y-a.y,b.z-a.z];
