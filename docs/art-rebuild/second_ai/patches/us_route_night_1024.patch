+  ctx.skyTint(M,18.6); check('2. 18:36 黃昏：偏暖（紅 > 藍）、比白天暗', glass.emissive.r>glass.emissive.b&&glass.emissive.b<0.9, JSON.stringify([glass.emissive.r,glass.emissive.b].map(v=>+v.toFixed(3))));
