+  r.add(new THREE.Mesh(g,floorM)); r.add(new THREE.Mesh(new THREE.BoxGeometry(0.3,0.3,0.3),propM)); r.add(new THREE.Mesh(new THREE.SphereGeometry(0.2),lampM)); return r; }
