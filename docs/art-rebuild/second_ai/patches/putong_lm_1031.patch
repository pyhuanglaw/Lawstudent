+// 普通教學館室內正式模型的光照貼圖（ART-ECON-3D-GAP-1021 B，LAWWW2-B 2026-10-31）——不需要瀏覽器。
+// teach3d.js 用 B3.attachFormal 接 putong_interior.glb，看到場景的 extras.lightmap 就接光照貼圖（Z3.roomLightmap）。這支檢查：
+//   ①extras.lightmap 的白天、晚上兩張都在
+//   ②牆、地板、天花板有第二套 UV（TEXCOORD_1）：沒有的話這些面吃不到光照貼圖
+//   ③燈板、輕鋼架不烘（--nolm）：沒有第二套 UV，照舊即時光
+// 用法：node tests/putong_interior_lm_unit.js
+const fs=require('fs'), path=require('path');
+const ROOT=path.resolve(__dirname,'..'), REL='assets/models/env/second_ai/putong_interior.glb';
+let fails=0; const check=(name,ok,info)=>{ console.log((ok?'PASS ':'FAIL ')+name+(info?'　'+info:'')); if(!ok) fails++; };
+const b=fs.readFileSync(path.join(ROOT,REL)), n=b.readUInt32LE(12), j=JSON.parse(b.slice(20,20+n).toString('utf8'));
+const sc=j.scenes[j.scene||0], lm=sc.extras&&sc.extras.lightmap;
+const files=lm?['day','night'].map(k=>lm[k]):[];
+check('① 光照貼圖：extras.lightmap 的白天、晚上兩張都在',!!lm&&files.length===2&&files.every(f=>f&&fs.existsSync(path.join(ROOT,f))),JSON.stringify(lm||null).slice(0,160));
+const uv1=nm=>{ const nd=j.nodes.find(x=>x.name===nm); if(!nd||nd.mesh==null) return null; return j.meshes[nd.mesh].primitives.every(p=>p.attributes.TEXCOORD_1!=null); };
+const want=['L0_floor','L0_ceil','L0_part','L1_floor','L1_ceil','L1_part'], got=want.map(k=>[k,uv1(k)]);
+check('② 地板、天花板、隔間牆有第二套 UV',got.every(([,v])=>v===true),JSON.stringify(got));
+const lit=j.nodes.filter(x=>/^L[01]_light$|tbar/.test(x.name||'')&&x.mesh!=null).map(x=>[x.name,uv1(x.name)]);
+check('③ 燈板、輕鋼架沒有第二套 UV（照舊即時光）',lit.length>0&&lit.every(([,v])=>v===false),JSON.stringify(lit).slice(0,200));
+console.log(fails?('FAIL '+fails):'ALL PASS'); process.exit(fails?1:0);
