+const ctx={Math}; vm.createContext(ctx);
+vm.runInContext([K0,KG,KGG,NP||'const KEY0N=null, KEYGN=null;',fA].join('\n')+'\nthis.KEYG=KEYG; this.KEYGN=KEYGN; this.KEY0=KEY0; this.KEY0N=KEY0N; this.sunAng=sunAng;',ctx);
