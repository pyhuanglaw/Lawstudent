+class UM:
+    """有 UV 的網格（貼圖集）：每個面自己給 UV"""
+    def __init__(self, name, mat): self.name, self.mat, self.bm = name, mat, bmesh.new(); self.uv = self.bm.loops.layers.uv.new('UVMap')
