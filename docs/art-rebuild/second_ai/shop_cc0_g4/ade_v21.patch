+def lifted(y0, h, t, a):
+    """厚 t、高 h 的東西繞 x 軸轉 a 以後：底貼在 y0 時的中心 y、沿 z 佔多寬"""
+    return y0 + (h * math.cos(abs(a)) + t * math.sin(abs(a))) / 2, h * math.sin(abs(a)) + t * math.cos(abs(a))
