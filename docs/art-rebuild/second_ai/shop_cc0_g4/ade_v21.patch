+def ubox(u, ctr, w, h, d, R, cells, skip=('-y',)):
+    """v1c：可以轉的貼圖方盒（UM）：ctr＝中心、w/h/d＝自己座標 x/y/z 的長度、R＝遊戲座標的 3×3 旋轉；cells＝{面: uv 範圍}，沒寫的面用 cells['*']"""
+    hs = (w / 2, h / 2, d / 2); C = Vector(ctr)
+    for k, (n, r, up) in UM.FACES.items():
+        if k in skip: continue
