+        n = -(-w // 16); best = None
+        for i in range(0, len(sky) - n + 1):
+            y = max(sky[i:i + n])
+            if best is None or y < best[1]: best = (i, y)
+        i, y = best; pos[nm] = (i * 16, y)
+        for j in range(i, i + n): sky[j] = y + h
+    assert max(sky) <= GH, f'atlas overflow {max(sky)}'
+    return pos, max(sky)
