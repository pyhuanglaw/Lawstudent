+        c = C + R @ Vector((n[0] * hs[0], n[1] * hs[1], n[2] * hs[2]))
+        u.rect(tuple(c), tuple(R @ Vector(r)), tuple(R @ Vector(up)), hw, hh, cells.get(k, cells['*']))
