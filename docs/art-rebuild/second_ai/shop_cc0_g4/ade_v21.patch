+    if side_cell: cells.update({k: side_cell for k in ('+x', '-x', '+z', '-z') if k != front})
+    if top_cell: cells['+y'] = top_cell
+    u.box(cx, cy, cz, abs(x1 - x0), abs(y1 - y0), abs(z1 - z0), fcell, front=front, cells=cells or None)
