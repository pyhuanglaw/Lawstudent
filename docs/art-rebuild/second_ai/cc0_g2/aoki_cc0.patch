+    n = noise(w, h, 6, rng.integers(1e6)) - 0.5; base *= (1 + n[..., None] * grain * 2)
+    im.paste(Image.fromarray(np.clip(base, 0, 255).astype(np.uint8)), (x0, y0))
+    if edge: ImageDraw.Draw(im).rectangle([x0, y0, x1 - 1, y1 - 1], outline=edge, width=3)
