+class Xf:
+    """物件自己的座標（x 右、z 前、y 上；正面朝 +z）→ 區域座標：中心 (px,pz)、轉 ry（人面向 (sin ry, cos ry)）"""
+    def __init__(self, px, pz, ry=0.0, py=0.0): self.px, self.pz, self.py, self.c, self.s, self.ry = px, pz, py, math.cos(ry), math.sin(ry), ry
