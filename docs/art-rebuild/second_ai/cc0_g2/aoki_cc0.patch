+
+def text_c(d, xy, s, f, fill):
+    bb = d.textbbox((0, 0), s, font=f); d.text((xy[0] - (bb[2] - bb[0]) / 2 - bb[0], xy[1] - (bb[3] - bb[1]) / 2 - bb[1]), s, font=f, fill=fill)
+
+
+def paper(im, bx, col, rng, edge=None, grain=0.05):
+    x0, y0, x1, y1 = bx; w, h = x1 - x0, y1 - y0
