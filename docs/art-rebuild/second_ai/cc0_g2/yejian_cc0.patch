+Mesh(P + 'floor', sh.M['floor'], tile=1.2).box(X0, X1, -0.02, 0.0, Z0, Z1).finish(sh.root)
+ce = Mesh(P + 'ceiling', sh.M['wall'], tile=1.6); ce.quad([(X0, H, Z0), (X1, H, Z0), (X1, H, Z1), (X0, H, Z1)]); ce.finish(sh.root, uv=True)
