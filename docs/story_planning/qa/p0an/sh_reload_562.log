  [ 226.5s] 讀檔以後畫面上出現的句子：[{"t": 167487, "k": "許柏翰｜你們認識？", "depth": 0, "cover": null}, {"t": 170368, "k": "祐廷｜我常去她們店裡吃麵。", "depth": 0, "cover": null}, {"t": 173154, "k": "許柏翰｜好。那紀錄你照做，意見我來講。", "depth": 0, "cover": null}, {"t": 178435, "k": "許柏翰｜阿姨，先跟您說，我們都是學生。今天講的，之後會請指導律師再看一次。", "depth": 0, "cover": null}, {"t": 184139, "k": "阿姨｜學生好啊。學生比較有耐心。", "depth": 0, "cover": null}, {"t": 190041, "k": "｜（阿姨把租約攤在桌上。語彤把它轉過來，對著柏翰。）", "depth": 0, "cover": null}, {"t": 196636, "k": "許柏翰｜（翻到最後一頁）書面的，五年，還有……快兩年。您一直住在店裡、做生意，對吧？", "depth": 0, "cover": null}, {"t": 202195, "k": "阿姨｜每天。過年也開。", "depth": 0, "cover": null}, {"t": 205155, "k": "許柏翰｜那這樣。房子賣了，租約跟著房子走。新屋主要接著當房東，到期以前，他不能叫你們搬。", "depth": 0, "cover": null}, {"t": 210571, "k": "阿姨｜仲介說他要租給連鎖店。", "depth": 0, "cover": null}, {"t": 213649, "k": "許柏翰｜那是到期以後的事。到期以前，他要等。", "depth": 0, "cover": null}, {"t": 219725, "k": "許柏翰｜這快兩年，可以拿來準備怎麼跟他談續約。", "depth": 0, "cover": null}, {"t": 225183, "k": "阿姨｜談？跟屋主談？我煮麵的耶。", "depth": 0, "cover": null}]
