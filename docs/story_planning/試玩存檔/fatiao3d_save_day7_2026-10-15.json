 "notes": [
  {
   "id": "case_camera",
   "title": "指定案例：網拍相機 1,000 元",
   "body": "賣家在拍賣網站把一台市價約一萬元的相機標成 1,000 元（少打一個零）。買家下標付款，賣家拒絕出貨。爭點：網頁標價是「要約」還是「要約之引誘」？賣家能否主張錯誤撤銷？",
   "day": 1
  },
  {
   "id": "law_154",
   "title": "民法 §154：要約與要約之引誘",
   "body": "貨物標定賣價陳列者，視為要約；但價目表之寄送，不視為要約。網拍頁面算哪一種，有爭論。",
   "day": 1
  },
  {
   "id": "law_88",
   "title": "民法 §88：意思表示錯誤",
   "body": "表意人若無過失，得撤銷；撤銷後對信賴者負賠償責任（§91）。",
   "day": 1
  },
  {
   "id": "law_91",
   "title": "民法 §91：撤銷後的賠償",
   "body": "表意人撤銷錯誤的意思表示後，對信賴其有效的相對人要負損害賠償。",
   "day": 2
  },
  {
   "id": "club_law",
   "title": "法律服務社",
   "body": "週三 19:00 萬才館 201。社長溫學姊。阿哲說一年級去會被操。",
   "day": 2
  },
  {
   "id": "law_153",
   "title": "民法 §153：契約成立",
   "body": "當事人互相表示意思一致者，契約即為成立。必要之點須一致，非必要之點推定成立。",
   "day": 2
  }
 ],
