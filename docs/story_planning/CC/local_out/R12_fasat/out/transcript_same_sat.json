 "same_first_dialog": {
  "lines": [
   [
    "雅筑學姊",
    "今天兩桌。你跟我。"
   ],
   [
    "",
    "（一位大學生，機車停在騎樓被拖吊了。）"
   ],
   [
    "",
    "你先問什麼？"
   ],
   [
    "雅筑學姊",
    "好。先聽完。"
   ],
   [
    "",
    "（他講了十五分鐘。最重要的那一句，在最後。）"
   ],
   [
    "民眾",
    "我只停了五分鐘。"
   ],
   [
    "研究所學長",
    "那天的時間、地點先寫清楚。單子還在嗎？"
   ],
   [
    "",
    "（隔壁桌，一個阿伯講了十分鐘，一直在講他兒子。大家都在翻六法。）"
   ],
   [
    "",
    "（初談紀錄，一頁。學長在最下面簽名。）"
   ]
  ],
  "menus": [
   [
    "「先請他從頭講一次。」",
    "「先問什麼時候發生的。」",
    "「先問手上有什麼資料。」"
   ],
   [
    "再待到十二點。",
    "先走。"
   ]
  ],
