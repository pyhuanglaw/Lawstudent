{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "水不要滾太久。滾久了，水就老了。",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（水屋裡，一個綁馬尾的女生正在一個一個擦茶杯。）",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "語彤，他今天第一天。妳帶他。",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "客人坐下先給水，不要先問點什麼。他們會自己看。",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "高三暑假開始。",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "風一來，葉子就往緣側的方向飛。你掃了三次，蘇姨說：「掃一次就好。剩下的是院子的。」",
   "at": "2025-09-20 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把水沖得太急，蘇姨說水會被你嚇到。",
   "at": "2025-09-20 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "烏龍。",
   "at": "2025-09-20 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "第一泡不要給客人。那是洗茶，也是叫醒它。",
   "at": "2025-09-20 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2025-09-20 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把茶巾一條一條晾在緣側。蘇姨泡了一杯給你：「今天你泡得最好的那一種。」",
   "at": "2025-09-20 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（一個下午下來，她跟你講的話不超過十句。）",
   "at": "2025-09-20 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（收店的時候，她倒了一杯剩下的烏龍茶，放在你旁邊。）",
   "at": "2025-09-20 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "第一天都這樣。下週就順了。",
   "at": "2025-09-20 15.67 wz_teahouse"
  }
 ],
