 "say": [
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "（小聲）二樓靠窗那排比較安靜。",
   "h": 11.917,
   "d": 21,
   "z": "library_hall",
   "adv": false
  },
  {
   "n": "",
   "c": null,
   "t": "（你們在長桌的一角坐下。她把書攤開，把手機翻過來蓋在桌上。）",
   "h": 12.213,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你先讀。我把這一章看完就好。",
   "h": 12.213,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她把一本很舊的筆記本和一本新的課本並排放好。）",
   "h": 12.213,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她看著窗外一個在等公車的人。）",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "那個人等的不是公車。他已經讓兩台過去了。",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我從小就這樣看人。在學校我不太說話，就一直看。",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你呢？你是看人的，還是被看的？",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "那一定很累。",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "被看的人，會比較會看別人。你應該也很會看。",
   "h": 12.963,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你去過淡水嗎。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……我家在淡水。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "可是我從來沒有跟朋友一起看過那裡的夕陽。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我以前念的學校都不在淡水，要住校。週末回家，也是去補習。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "同學都住別的地方。……沒有人會特地跑去淡水看夕陽。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "所以我到現在還不知道，淡水的夕陽最後長什麼樣子。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她把筆記本的邊角壓平，才收進包包。）",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "謝謝你陪我讀。下次我請你喝茶。",
   "h": 13.713,
   "d": 21,
   "z": "library_hall",
   "adv": true
  }
 ],
