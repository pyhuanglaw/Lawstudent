last": {"ev_camp_d1_bus": -25, "ev_camp_d1_ice": -25, "ev_camp_d1_field": -25, "ev_camp_d1_party": -25, "ev_camp_d1_walk": -25, "ev_camp_d2_quiz": -24, "ev_camp_d2_water": -24, "ev_camp_d2_bbq": -24, "ev_camp_d2_fire": -24, "ev_camp_d2_talk": -24, "ev_camp_d3_quiz": -23, "ev_camp_d3_end": -23}, "count": 12}, "legal": {"q": {}, "misc": {}, "log": []}, "cg": {"unlocked": []}, "savedAt": 1793731524123, "bike": {"riding": false, "zone": "campus", "x": 25, "z": 57.9, "yaw": 1.5707963267948966}, "invites": [], "msgs": [{"day": -32, "h": 20, "who": null, "text": "迎新宿營 8/22～8/24，三天兩夜，山上的青年活動中心。新生都要參加，車子、住宿、吃的系學會處理。8/22 早上八點半校門集合。", "iv": null, "th": "g:law_new", "from": "law_assoc", "name": "系學會"}, {"day": -26, "h": 21, "who": null, "text": "小隊名單｜第七小隊：祐廷、張哲維、吳芯慈、郭沛珊、江明軒、許柏翰、凱文", "iv": null, "th": "g:law_new", "from": "law_assoc", "name": "系學會"}, {"day": -25, "h": 13.5, "who": "classmate_peishan", "text": "加了郭沛珊的聯絡方式。", "iv": null}, {"day": -18, "h": 22.67, "who": "kai", "text": "你的冷氣遙控器在我這", "iv": null, "th": "p:kai", "from": "kai", "ask": {"id": "scene_p:kai_-18_2267", "opts": [{"t": "你可以直接講啊", "say": [{"from": "kai", "text": "我耳機戴著 懶得拿下來"}, {"from": "kai", "text": "幾度"}]}, {"t": "好 開幾度", "say": [{"from": "kai", "text": "27 可以嗎 我怕冷"}]}]}, "ans": 0}, {"day": -18, "h": 22.67, "who": null, "text": "你可以直接講啊", "iv": null, "th": "p:kai", "from": "player"}, {"day": -18, "h": 22.67, "who": "kai", "text": "我耳機戴著 懶得拿下來", "iv": null, "th": "p:kai", "from": "kai"}, {"day": -18, "h": 22.67, "who": "kai", "text": "幾度", "iv": null, "th": "p:kai", "from": "kai"}], "contacts": {"classmate_peishan": -25, "kai": -18, "kexin": -18}, "phone": {"groups": {"law_new": {"name": "法律系 114 新生（系學會）", "day": 1}, "camp_squad_y1": {"name": "第七小隊", "day": 1}, "family_law": {"name": "法律系直屬家族", "day": -18}}, "seen": {}, "q": [{"day": -23, "h": 21, "items": [{"th": "g:camp_squad_y1", "text": "（小隊輔傳了一張照片：營地門口，七個人，Kevin 拿著翻到背面的名牌。）"}, {"th": "g:camp_squad_y1", "from": "camp_leader", "name": "小隊輔", "text": "照片都在相簿了 自己存"}, {"th": "g:camp_squad_y1", "text": "（群組裡「凱文」變成「Kevin 大二」）"}, {"th": "g:camp_squad_y1", "from": "kevin", "name": "Kevin 大二", "text": "改名了 以後叫學長"}, {"th": "g:camp_squad_y1", "from": "kevin", "name": "Kevin 大二", "text": "民總考古題我有 開學再說"}, {"th": "g:camp_squad_y1", "from": "classmate_mingxuan", "name": "明軒", "text": "（一張他睡在車上的照片，不知道誰拍的）"}, {"th": "g:camp_squad_y1", "from": "classmate_mingxuan", "name": "明軒", "text": "這張誰拍的 哈哈"}, {"th": "g:camp_squad_y1", "from": "zhe", "name": "阿哲", "text": "29 號見"}], "tag": "camp_squad_photo"}, {"day": -18, "h": 17.5, "items": [{"th": "g:camp_squad_y1", "from": "zhe", "name": "阿哲", "text": "我在高鐵上了"}, {"th": "g:camp_squad_y1", "from": "zhe", "name": "阿哲", "text": "七點到宿舍"}], "tag": "camp_squad_829"}, {"day": -17, "h": 21, "items": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "學弟妹好～我是 Kevin，大二。先講幾件事：開學前先不要買二手書，等學長姐的；民總很重要；有問題就問，先自己查一下也可以。", "pin": true}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "新的家族學弟妹都進群了嗎？"}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "欸 祐廷？我當臥底那一隊的？原來你是我們家族的"}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "所以我宿營騙了自己家的學弟三天 好啦對不起"}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "考古題茶會那天給你們。", "ask": {"opts": [{"t": "是我。", "set": {"FAM_GROUP_REPLIED": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，收到一個。"}]}, {"t": "（貼圖）", "set": {"FAM_GROUP_REPLIED": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，收到一個。"}]}]}}], "tag": "fam_w0"}, {"day": -11, "h": 20, "items": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "周老師說的那本，我有舊的。"}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "📷（一本書的封面，邊角捲起來）"}, {"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "要的說，先說先拿。", "ask": {"opts": [{"t": "我要。", "set": {"KEVIN_OLD_BOOK": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，下禮拜一放系學會辦公室，寫你名字。"}]}]}}], "tag": "kevin_old_book"}, {"day": -16, "h": 22.166666666666668, "items": [{"th": "p:kexin", "from": "kexin", "text": "明天開學了。"}, {"th": "p:kexin", "from": "kexin", "text": "你課表都排好了嗎？", "ask": {"opts": [{"t": "排好了，週四有民總。", "say": [{"th": "p:kexin", "from": "kexin", "text": "好。我週四也是滿堂。"}, {"th": "p:kexin", "from": "kexin", "text": "早點睡，明天不要遲到。"}]}, {"t": "還在等加選。", "say": [{"th": "p:kexin", "from": "kexin", "text": "我也是，有一堂候補排第十二個。"}, {"th": "p:kexin", "from": "kexin", "text": "應該沒救了。早點睡。"}]}, {"t": "有點緊張。", "say": [{"th": "p:kexin", "from": "kexin", "text": "我也是。"}, {"th": "p:kexin", "from": "kexin", "text": "早點睡。"}]}]}}], "tag": "kx_eve"}], "n": 0, "filmRen": 1, "worldRen": 1}, "habits": {"place:dorm:afternoon": {"n": 1, "first": -18, "last": -18, "days": [-18]}}, "goal": "整理行李。缺的東西明天去公館買。", "goalDest": null}