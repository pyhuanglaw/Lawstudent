他們問過。"}, {"ms": 82397, "h": 19.884, "zone": "noodle", "who": "沈以安", "t": "第一頁第一個是對的。我運氣不錯。"}, {"ms": 102947, "h": 8.21, "zone": "dorm", "who": "", "t": "早安。今天的課：09:10　民事訴訟法甲上　法律系館A 201　／　13:20　證券交易法　法律系館A 202"}], "arrive": {"her": [{"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 0.56, "pSeat": true}, {"zone": "no