: {"const_1": 1, "pe_y1s1": 4, "ge_film_y1s1": 4, "econ_principles_1": 4, "crim_gen1": 3, "civ_general": 3}, "electives": {}, "grades": {}, "note": {"sel_Y1S1": 1, "termStart": "Y1S1", "skip_-14:chinese_y1:am": 1, "skipn_chinese_y1_Y1S1": 4, "skip_-13:crim_gen1:am": 1, "skipn_crim_gen1_Y1S1": 1, "skip_-12:english_y1:am": 1, "skipn_english_y1_Y1S1": 4, "skip_-8:const_1:am": 1, "skipn_const_1_Y1S1": 3, "skip_-7:chinese_y1:am": 1, "rem_-6:crim_gen1:am": 1, "skip_-5:english_y1:am": 1, "skip_-1:const_1:am": 1, "skip_0:chinese_y1:am": 1, "skip_2:english_y1:am": 1, "skip_6:const_1:am": 1, "skip_7:chinese_y1:am": 1, "skip_9:english_y1:am": 1}, "disc": {}, "ask": {"Y1S1:CRIM45_31": "A", "Y1S1:CRIM45_01": "A"}, "late": {}, "abs": {}, "idv": 3, "rollSince": 1, "seat": {"const_1": {"zone": "classroom", "room": null, "x": -0.75, "z": 0.4, "lv": 0}, "ge_film_y1s1": {"zone": "putong", "room": "101", "x": -10.4, "z": -3.4, "lv": 0}, "econ_principles_1": {"zone": "putong", "room": "101", "x": -12.4, "z": -5.8, "lv": 0}, "crim_gen1": {"zone": "classroom", "room": null, "x": -0.75, "z": 0.4, "lv": 0}, "civ_general": {"zone": "classroom", "room": null, "x": -0.75, "z": 0.4, "lv": 0}}, "waitLast": "10:econ_principles_1:am", "attRule": {"Y1S1:pe_y1s1": -15, "Y1S1:ge_film_y1s1": -14, "Y1S1:econ_principles_1": -11}, "roll": {"Y1S1:pe_y1s1": [2, 3, 10, 12], "Y1S1:ge_film_y1s1": [6, 7, 13, 14], "Y1S1:econ_principles_1": [4, 5, 10, 11]}, "rollSaid": {"Y1S1:pe_y1s1:2": 1, "Y1S1:pe_y1s1:3": 1, "Y1S1:econ_principles_1:4": 1}}, "daily": {"gym": {"seen": [], "fit": 4, "fitDay": 6, "upIx": 0}, "shopHear": {"day": -6, "by": {}, "used": {}}}, "invites": [], "msgs": [{"day": -32, "h": 20, "who": null, "text": "迎新宿營 8/22～8/24，三天兩夜，山上的青年活動中心。新生都要參加，車子、住宿、吃的系學會處理。8/22 早上八點半校門集合。", "iv": null, "th": "g:law_new", "from": "law_assoc", "name": "系學會"}, {"day": -26, "h": 21, "who": null, "text": "（小隊名單貼出來了。第七小隊七個人，你認得的只有自己的名字。）", "iv": null, "th": "g:law_new"}, {"day": -24, "h": 20, "who": "classmate_peishan", "text": "加了沛珊的聯絡方式。", "iv": null}, {"day": -23, "h": 21, "who": null, "text": "📷（小隊合照）", "iv": null, "th": "g:camp_squad_y1", "from": "classmate_xinci", "name": "芯慈", "tag": "camp_squad_photo"}, {"day": -23, "h": 21.01, "who": null, "text": "宿營辛苦了。", "iv": null, "th": "g:camp_squad_y1", "from": "classmate_xinci", "name": "芯慈", "tag": "camp_squad_photo"}, {"day": -23, "h": 21.02, "who": null, "text": "我只有半張臉在裡面", "iv": null, "th": "g:camp_squad_y1", "from": "classmate_peishan", "name": "沛珊", "tag": "camp_squad_photo"}, {"day": -18, "h": 17.5, "who": "zhe", "text": "我在高鐵上了。", "iv": null, "th": "p:zhe", "from": "zhe", "name": "阿哲", "tag": "camp_squad_829"}, {"day": -18, "h": 17.51, "who": "zhe", "text": "七點到宿舍。你到了沒？", "iv": null, "th": "p:zhe", "from": "zhe", "name": "阿哲", "tag": "camp_squad_829"}, {"day": -18, "h": 22.67, "who": "kai", "text": "你的冷氣遙控器在我這", "iv": null, "th": "p:kai", "from": "kai", "ask": {"id": "scene_p:kai_-18_2267", "opts": [{"t": "你可以直接講啊", "say": [{"from": "kai", "text": "我耳機戴著 懶得拿下來"}, {"from": "kai", "text": "幾度"}]}, {"t": "好 開幾度", "say": [{"from": "kai", "text": "27 可以嗎 我怕冷"}]}]}, "ans": 0}, {"day": -18, "h": 22.67, "who": null, "text": "你可以直接講啊", "iv": null, "th": "p:kai", "from": "player"}, {"day": -18, "h": 22.67, "who": "kai", "text": "我耳機戴著 懶得拿下來", "iv": null, "th": "p:kai", "from": "kai"}, {"day": -18, "h": 22.67, "who": "kai", "text": "幾度", "iv": null, "th": "p:kai", "from": "kai"}, {"day": -17, "h": 21, "who": null, "text": "學弟妹好～我是 Kevin，大二。先講幾件事：開學前先不要買二手書，等學長姐的；民總很重要；有問題就問，先自己查一下也可以。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "pin": true, "tag": "fam_w0"}, {"day": -17, "h": 21.01, "who": null, "text": "新的家族學弟妹都進群了嗎？", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "fam_w0"}, {"day": -17, "h": 21.02, "who": null, "text": "有進來的舉個手，考古題茶會那天給你們。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "fam_w0", "ask": {"opts": [{"t": "（舉手）", "set": {"FAM_GROUP_REPLIED": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，收到一個。"}]}, {"t": "我在。", "set": {"FAM_GROUP_REPLIED": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，收到一個。"}]}], "id": "a1"}}, {"day": -16, "h": 14, "who": null, "text": "你被加進「法律系（全班）」。", "iv": null, "th": "g:law_class", "tag": "law_class_join"}, {"day": -16, "h": 14.01, "who": null, "text": "新生茶會：9/2（二）18:30，法律系館B一樓大廳。會說家族怎麼分，有點心。", "iv": null, "th": "g:law_class", "from": "law_assoc", "name": "系學會", "tag": "law_class_join"}, {"day": -16, "h": 14.02, "who": null, "text": "不用報名，來就好。", "iv": null, "th": "g:law_class", "from": "law_assoc", "name": "系學會", "tag": "law_class_join"}, {"day": -16, "h": 14.25, "who": null, "text": "請問要穿系服嗎", "iv": null, "th": "g:law_class", "name": "同學", "tag": "law_class_q"}, {"day": -16, "h": 14.26, "who": null, "text": "我們還沒有系服吧", "iv": null, "th": "g:law_class", "name": "同學", "tag": "law_class_q"}, {"day": -15, "h": 8.17, "who": null, "text": "9/6（六）10:00～16:00　社團博覽會（椰影大道）", "iv": null, "th": "sys", "name": "行事曆", "tag": "fair_y1_cal"}, {"day": -15, "h": 9.17, "who": "kexin", "text": "加了杜可昕的聯絡方式。", "iv": null}, {"day": -15, "h": 21, "who": null, "text": "203 的群組", "iv": null, "th": "g:r203", "from": "zhe", "tag": "rt_r203_0901_0"}, {"day": -15, "h": 21, "who": null, "text": "大家好，我是怡君，台中人，喜歡貓。請多指教。", "iv": null, "th": "g:law_board", "name": "怡君", "tag": "sis_b_intro"}, {"day": -15, "h": 21.01, "who": null, "text": "誰帶了吹風機", "iv": null, "th": "g:r203", "from": "zhe", "tag": "rt_r203_0901_0"}, {"day": -15, "h": 21.01, "who": null, "text": "我是家瑋，高雄來的，興趣是看電影。", "iv": null, "th": "g:law_board", "name": "家瑋", "tag": "sis_b_intro"}, {"day": -15, "h": 21.02, "who": null, "text": "大家好，我是祐廷，財經法學組，澄嶼高中畢業。興趣是數學跟睡覺。請多指教。", "iv": null, "th": "g:law_board", "from": "player", "tag": "sis_b_intro"}, {"day": -15, "h": 21.03, "who": null, "text": "我是品萱，宜蘭人。第一次住宿舍，有點緊張。", "iv": null, "th": "g:law_board", "name": "品萱", "tag": "sis_b_intro"}, {"day": -15, "h": 21.03, "who": null, "text": "我有。在第二個抽屜。", "iv": null, "th": "g:r203", "from": "classmate_bohan", "tag": "rt_r203_0901_1"}, {"day": -15, "h": 21.08, "who": null, "text": "所以吹風機要排隊嗎", "iv": null, "th": "g:r203", "from": "kai", "tag": "rt_r203_0901_2"}, {"day": -14, "h": 12.5, "who": null, "text": "歡迎學弟。選課或宿舍有問題，可以私訊問我。", "iv": null, "th": "g:law_board", "from": "heroine_05", "name": "溫書瑀", "ytFix": 1, "tag": "sis_b_comment"}, {"day": -13, "h": 12.32, "who": null, "text": "（群組）阿哲：吳教授今天一個「行為」講了一整個早上。你沒錯過什麼，也錯過了全部。", "iv": null}, {"day": -13, "h": 21, "who": null, "text": "學姊好，謝謝妳的留言。想問一下，民總要先買哪一本嗎？", "iv": null, "th": "p:heroine_05", "from": "player", "tag": "sis_b_dm"}, {"day": -13, "h": 21.01, "who": "heroine_05", "text": "先不要買。第一堂課老師會說用哪一本。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_b_dm"}, {"day": -13, "h": 21.02, "who": "heroine_05", "text": "真的想先看的話，系圖有，二樓。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_b_dm"}, {"day": -13, "h": 21.03, "who": null, "text": "好，謝謝學姊。", "iv": null, "th": "p:heroine_05", "from": "player", "tag": "sis_b_dm"}, {"day": -13, "h": 21.04, "who": "heroine_05", "text": "不會。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_b_dm"}, {"day": -12, "h": 21, "who": null, "text": "禮拜六社博！系籃的攤位在晨思鐘旁邊，大一的來找學長聊聊～", "iv": null, "th": "g:law_class", "from": "law_assoc", "name": "系學會", "tag": "fair_y1_dept"}, {"day": -12, "h": 21, "who": null, "text": "家族群組開好了。學弟。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "sis_b_fam"}, {"day": -12, "h": 21.01, "who": null, "text": "上面那位是你的直屬學姊。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "sis_b_fam"}, {"day": -12, "h": 21.02, "who": null, "text": "學弟好。我們留言區見過了。", "iv": null, "th": "g:family_law", "from": "heroine_05", "name": "溫學姊", "ytFix": 1, "tag": "sis_b_fam"}, {"day": -12, "h": 21.03, "who": null, "text": "你們認識？", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "sis_b_fam"}, {"day": -12, "h": 21.04, "who": null, "text": "他自介我有留言。", "iv": null, "th": "g:family_law", "from": "heroine_05", "name": "溫學姊", "ytFix": 1, "tag": "sis_b_fam"}, {"day": -11, "h": 20, "who": null, "text": "周老師說的那本，我有舊的。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "kevin_old_book"}, {"day": -11, "h": 20.01, "who": null, "text": "📷（一本書的封面，邊角捲起來）", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "kevin_old_book"}, {"day": -11, "h": 20.02, "who": null, "text": "要的說，先說先拿。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "kevin_old_book", "ask": {"opts": [{"t": "我要。", "set": {"KEVIN_OLD_BOOK": true}, "say": [{"th": "g:family_law", "from": "kevin", "name": "Kevin", "text": "好，下禮拜一放系學會辦公室，寫你名字。"}]}], "id": "a2"}}, {"day": -11, "h": 21, "who": "zhe", "text": "明天社博要不要一起去？", "iv": null, "th": "p:zhe", "from": "zhe", "tag": "aa613_zhe_fair"}, {"day": -11, "h": 21, "who": null, "text": "明天社博！書瑀學姊在法服顧攤，大一的去打個招呼～", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "fair_y1_kevin"}, {"day": -11, "h": 21.01, "who": "zhe", "text": "十點，晨思鐘。我要去系籃那攤。", "iv": null, "th": "p:zhe", "from": "zhe", "tag": "aa613_zhe_fair", "ask": {"id": "aa613_zhe_fair", "until": -228, "opts": [{"t": "好。", "set": {"AA613_ZHE_FAIR": -10}}, {"t": "我晚點自己去。"}]}}, {"day": -11, "h": 21.17, "who": null, "text": "明天社博有人要去嗎？我想去看合唱團。", "iv": null, "th": "g:camp_squad_y1", "from": "classmate_xinci", "name": "芯慈", "tag": "aa613_squad"}, {"day": -11, "h": 21.18, "who": null, "text": "我！我十一點才能到。", "iv": null, "th": "g:camp_squad_y1", "from": "classmate_peishan", "name": "沛珊", "tag": "aa613_squad"}, {"day": -8, "h": 12.32, "who": null, "text": "（群組）Alison：張教授今天又發了二十頁講義，我幫你拿了一份。", "iv": null}, {"day": -8, "h": 21, "who": null, "text": "各位～這週五晚上家聚，大一到大四都來，地點晚點貼。", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "sis_fam_inv"}, {"day": -8, "h": 21.3, "who": null, "text": "📹（一隻貓把桌上的筆一支一支推下去）", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "dp_kevin_video_0_0"}, {"day": -8, "h": 21.3, "who": null, "text": "收到。", "iv": null, "th": "g:family_law", "from": "heroine_05", "name": "溫學姊", "ytFix": 1, "tag": "dp_kevin_video_0_1"}, {"day": -7, "h": 22, "who": null, "text": "請問有人知道民總的指定教科書要買哪一本嗎", "iv": null, "th": "g:law_class", "from": "classmate_peishan", "name": "沛珊", "tag": "ps_w2_msg"}, {"day": -7, "h": 22.01, "who": null, "text": "老師說了兩本 我只抄到一本", "iv": null, "th": "g:law_class", "from": "classmate_peishan", "name": "沛珊", "tag": "ps_w2_msg"}, {"day": -7, "h": 22.02, "who": null, "text": "我有學長的舊版 你要的話我拍給你", "iv": null, "th": "g:law_class", "from": "zhe", "name": "阿哲", "tag": "ps_w2_msg"}, {"day": -7, "h": 22.03, "who": null, "text": "好 謝謝！", "iv": null, "th": "g:law_class", "from": "classmate_peishan", "name": "沛珊", "tag": "ps_w2_msg"}, {"day": -6, "h": 21.67, "who": "heroine_01", "text": "明天民總，我坐第二排。旁邊通常沒人。", "iv": null, "th": "p:heroine_01", "from": "heroine_01", "tag": "dp_a118_y1s1_an_row_0_0"}, {"day": -5, "h": 15.17, "who": "classmate_youchen", "text": "加了賴宥辰的聯絡方式。", "iv": null}, {"day": -5, "h": 21.67, "who": "heroine_01", "text": "📷（宿舍公告欄）", "iv": null, "th": "p:heroine_01", "from": "heroine_01", "tag": "dp_a118_y1s1_an_notice_0_0"}, {"day": -5, "h": 21.68, "who": "heroine_01", "text": "這張公告的第三行和第五行矛盾。我寫信問了。", "iv": null, "th": "p:heroine_01", "from": "heroine_01", "tag": "dp_a118_y1s1_an_notice_0_1", "ask": {"id": "r709:heroine_01:0:-5", "until": -62.31999999999999, "opts": [{"t": "哪裡矛盾？", "say": [{"from": "heroine_01", "text": "第三行說十一點以後不能用吹風機，第五行說浴室開到十一點半。"}, {"from": "heroine_01", "text": "洗完頭的人怎麼辦。"}], "rel": {"trust": 2, "fam": 1}, "relWho": "heroine_01"}, {"t": "妳真的寫信去問了？", "say": [{"from": "heroine_01", "text": "規則是我們要住的。總要有人問。"}], "rel": {"comf": 2, "npcRom": 1}, "relWho": "heroine_01"}, {"t": "（傳一張男宿公告的照片）", "say": [{"from": "heroine_01", "text": "你們的也有問題。第四行。"}, {"from": "heroine_01", "text": "要不要也寫信？我可以借你格式。"}], "rel": {"comf": 2, "fam": 1}, "relWho": "heroine_01"}]}}, {"day": -1, "h": 21.3, "who": null, "text": "📹（一隻柯基在海邊追浪，又被浪追回來）", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "dp_kevin_video_1_0"}, {"day": -1, "h": 21.3, "who": null, "text": "收到。", "iv": null, "th": "g:family_law", "from": "heroine_05", "name": "溫學姊", "ytFix": 1, "tag": "dp_kevin_video_1_1"}, {"day": 0, "h": 21, "who": null, "text": "學姊，想問一下，妳憲法那時候怎麼準備的？", "iv": null, "th": "p:heroine_05", "from": "player", "tag": "sis_fam_msg"}, {"day": 0, "h": 21.01, "who": "heroine_05", "text": "上課講的先弄懂，考前多寫題目。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_fam_msg"}, {"day": 0, "h": 21.02, "who": "heroine_05", "text": "解題書我推補習班那本，題目多，解得也清楚。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_fam_msg"}, {"day": 0, "h": 21.03, "who": null, "text": "好，我去買。謝謝學姊。", "iv": null, "th": "p:heroine_05", "from": "player", "tag": "sis_fam_msg"}, {"day": 0, "h": 21.04, "who": "heroine_05", "text": "加油。", "iv": null, "th": "p:heroine_05", "from": "heroine_05", "ytFix": 1, "tag": "sis_fam_msg"}, {"day": 1, "h": 7.42, "who": null, "text": "冷氣遙控器在阿凱的抽屜。請用完放回去。", "iv": null, "th": "g:r203", "from": "classmate_bohan", "tag": "rt_r203_ac_0"}, {"day": 3, "h": 12.17, "who": null, "text": "今天下午四點，圓窗館前拍系學會合照。", "iv": null, "th": "g:law_class", "from": "law_assoc", "name": "系學會", "tag": "l123_l3_inv_1"}, {"day": 6, "h": 12, "who": "classmate_peishan", "text": "你借我的筆記，我抄完了！", "iv": null, "th": "p:classmate_peishan", "from": "classmate_peishan", "tag": "b105_d4_dm"}, {"day": 6, "h": 12.01, "who": "classmate_peishan", "text": "你哪天經過女舍門口跟我說，我拿下去給你！", "iv": null, "th": "p:classmate_peishan", "from": "classmate_peishan", "tag": "b105_d4_dm"}, {"day": 6, "h": 21.3, "who": null, "text": "補習班的學生問我律師是不是很賺 我說等我考上再告訴你", "iv": null, "th": "g:family_law", "from": "kevin", "name": "Kevin", "tag": "dp_kevin_video_2_0"}, {"day": 6, "h": 21.3, "who": null, "text": "收到。", "iv": null, "th": "g:family_law", "from": "heroine_05", "name": "溫學姊", "ytFix": 1, "tag": "dp_kevin_video_2_1"}, {"day": 7, "h": 21, "who": "classmate_xinci", "text": "明天下午法圖有教怎麼查判決，三點半。之後寫報告會用到。", "iv": null, "th": "p:classmate_xinci", "from": "classmate_xinci", "tag": "aa613_xc_lib_8"}, {"day": 7, "h": 21.01, "who": "classmate_xinci", "text": "我想去。你要不要？", "iv": null, "th": "p:classmate_xinci", "from": "classmate_xinci", "tag": "aa613_xc_lib_8", "ask": {"id": "aa613_xc_lib_8", "until": 207.5, "opts": [{"t": "好。", "set": {"AA613_XC_LIB": 8}}, {"t": "這次先不用。"}]}}, {"day": 9, "h": 21.5, "who": "heroine_01", "text": "📷（報告的分工表）", "iv": null, "th": "p:heroine_01", "from": "heroine_01", "tag": "an_split_table"}], "contacts": {"classmate_peishan": -24, "kai": -18, "kexin": -15, "heroine_01": -11, "classmate_youchen": -5}, "phone": {"groups": {"law_new": {"name": "法律系 114 新生（系學會）", "day": 1}, "camp_squad_y1": {"name": "第七小隊", "day": 1}, "family_law": {"name": "法律系直屬家族", "day": -18}, "law_class": {"name": "法律系（全班）", "day": -16}, "law_board": {"name": "法律系新生（自介版）", "day": -16}, "r203": {"name": "203", "day": -14}, "home": {"name": "家人", "day": -12}}, "seen": {}, "q": [{"day": 15, "h": 21, "items": [{"th": "p:zhe", "from": "zhe", "text": "中秋烤肉，河濱，七點。飲料自己帶。", "ask": {"until": 451, "opts": [{"t": "去。", "set": {"BBQ_YES": true}}, {"t": "這次不行。", "set": {"BBQ_NO": true}}]}}], "tag": "bbq_ask"}], "n": 4, "fav": [], "filmRen": 1, "worldRen": 1}, "goal": "今天放假（教師節），沒有課。自由活動：去圖書館、公館，或找人聊天", "goalDest": null, "outings": [{"state": "done", "ask": null, "travelH": 0.25, "id": "y1_fam_dinner", "ev": "ev_sis_fam_dinner", "day": -4, "h": 19, "late": 0.25, "place": "公館巷子裡的簡餐店", "title": "家聚 19:00（公館巷子裡的簡餐店）", "travel": "走過去約 15 分鐘"}, {"state": "done", "ask": null, "travelH": 0.16666666666666666, "id": "l123_l3_1", "goto": {"zone": "campus", "x": -104, "z": -17, "yaw": 3.141592653589793}, "early": 0.083