, {"ms": 86448, "h": 19.883, "zone": "noodle", "who": "沈以安", "t": "一個人去的話，我會一直寫筆記。所以還沒去。"}, {"ms": 87713, "h": 19.883, "zone": "noodle", "who": "沈以安", "t": "第一頁第一個是對的。我運氣不錯。"}, {"ms": 108357, "h": 8.209, "zone": "dorm", "who": "", "t": "早安。今天的課：09:10　民法債編總論（二）　法律系館A 201"}], "arrive": {"her": [{"zone": "noodle", "h": 19.12, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose