 "say": [
  {
   "n": "",
   "c": null,
   "t": "（學士服掛在門後面，已經燙過了。）",
   "at": "2029-06-02 8.00 dorm"
  },
  {
   "n": "",
   "c": null,
   "t": "（看台上，媽媽一直在揮手。爸爸舉著手機，沒有放下來過。）",
   "at": "2029-06-02 9.00 gym_arena"
  },
  {
   "n": "",
   "c": null,
   "t": "（撥穗。帽子上的穗從右邊換到左邊，只有一秒。）",
   "at": "2029-06-02 11.00 gym_arena"
  },
  {
   "n": "媽媽",
   "c": null,
   "t": "我們家第一個首都帝大畢業的。",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "",
   "c": null,
   "t": "（媽媽哭了。）",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "",
   "c": null,
   "t": "（爸爸沒有說話，拍照拍了五十張。）",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "姊姊",
   "c": null,
   "t": "媽，不要哭了，妝。",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "媽媽",
   "c": null,
   "t": "（從包包裡拿出一個信封）對了，大伯叫我拿給你——",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "姊姊",
   "c": null,
   "t": "媽！今天！今天不要！",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "",
   "c": null,
   "t": "祐廷接過信封，放進學士服的口袋。",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "",
   "c": null,
   "t": "（媽媽擦了一下眼睛。）",
   "at": "2029-06-02 11.92 linze"
  },
  {
   "n": "",
   "c": null,
   "t": "（晨思鐘前，同班的人擠成三排。有人在喊「中間的蹲下」。）",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "",
   "c": null,
   "t": "（語彤從社科院那邊跑過來，擠進照片的角落。她媽媽在後面拿著手機拍。）",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "Alison",
   "c": "yu",
   "t": "（把學士帽戴到阿哲頭上）你的帽子歪了。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "阿哲",
   "c": "zhe",
   "t": "那是妳的帽子。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "",
   "c": null,
   "t": "（語彤穿著學士服，手上拿著一把深藍色的長柄傘。外面在飄雨。）",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "",
   "c": null,
   "t": "（典禮結束。語彤旁邊站著一位穿著套裝的女士，手上抱著花。）",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……媽。這是祐廷。茶屋的。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "語彤的媽媽",
   "c": "語彤的媽媽",
   "t": "（看了你一眼，點了一下頭）你好。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "",
   "c": null,
   "t": "（她們拍了一張合照。語彤的媽媽把花給她，沒有多說什麼。）",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "語彤的媽媽",
   "c": "語彤的媽媽",
   "t": "恭喜。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "恭喜。……四年，我們都在總圖三樓。你都坐我斜對面。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "阿凱",
   "c": "kai",
   "t": "畢業快樂。宵夜？",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "祐廷",
   "c": null,
   "t": "……現在才中午。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "阿凱",
   "c": "kai",
   "t": "那晚上。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "今天不排班。晚上來我家，我煮。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "阿哲",
   "c": "zhe",
   "t": "晚上五點半兩點半啦，能來的都來。",
   "at": "2029-06-02 12.00 campus"
  },
  {
   "n": "",
   "c": null,
   "t": "（公館的餐廳。爸爸點了一桌，說是慶祝。）",
   "at": "2029-06-02 13.51 gongguan"
  },
  {
   "n": "",
   "c": null,
   "t": "（媽媽把每一道菜都拍了一張。）",
   "at": "2029-06-02 13.51 gongguan"
  },
  {
   "n": "姊姊",
   "c": null,
   "t": "媽，妳拍菜比拍他多。",
   "at": "2029-06-02 13.51 gongguan"
  }
 ],
