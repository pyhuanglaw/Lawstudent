1:8800/assets/bg/d01_base_afternoon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "溫書瑀", "t": "我會用。", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d01_base_afternoon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "溫書瑀", "t": "我一次都沒看時間。", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d01_base_afternoon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "", "t": "（今天去了華山1914文創園區：老倉", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d01_base_afternoon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "", "t": "（今天去了華山1914文創園區：老倉庫裡的展覽、週末市集。花了 310 元（含來回車資）。）", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d01_base_afternoon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}], "after": {"zone": "dorm", "h": 14.19, "money": 21690, "trips": [{"status": "done", "spots": ["D01.expo", "D01.market"]}]}}, "D02": {"book": {"book": {"trip": "T0001", "depart": 10, "back": 13.5, "kind": "half", "transport": "mrt", "fare": 60}, "out": {"id": "date_T0001", "h": 10.5, "travelH": 0.5, "title": "和溫書瑀去松山文創園區"}, "money": 22000}, "picked": [[["現在出發松山文創園區　捷運 約 30 分鐘", "到時間再說"], "現在出發松山文創園區　捷運 約 30 分鐘"], ["DL", "生態池"], [["「那今天就坐久一點。」", "「要不要分我一口？」"], "「那今天就坐久一點。」"], ["DL", "製菸工廠的長廊"], [["「妳在想法服的事？」", "「現在有了。」"], "「妳在想法服的事？」"], ["DL", "差不多了，回去吧"]], "lines": [{"who": "", "t": "手", "cap": "", "bg": null}, {"who": "", "t": "手機｜提醒：10:00，你約了溫書瑀去松山文創園區。", "cap": "", "bg": null}, {"who": "", "t": "（松山文創園區。）", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d02_base_overcast.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "溫書瑀", "t": "這裡以前是菸廠，我來找過一次資料。", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d02_base_overcast.webp\")", "color": "rgba(10, 12, 18, 0.28)"}}, {"who": "溫書瑀", "t": "今天什麼都不查。", "cap": "", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8800/assets/bg/d02_base_overcast.webp\")", "color": "r