 "say": [
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "嗯。你常來這間嗎？",
   "h": 9.776,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她看著窗外一個在等公車的人。）",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "那個人等的不是公車。他已經讓兩台過去了。",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我從小就這樣看人。在學校我不太說話，就一直看。",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你呢？你是看人的，還是被看的？",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "那一定很累。",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "被看的人，會比較會看別人。你應該也很會看。",
   "h": 10.151,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你去過淡水嗎。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……我家在淡水。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "可是我從來沒有跟朋友一起看過那裡的夕陽。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我以前念的學校都不在淡水，要住校。週末回家，也是去補習。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "同學都住別的地方。……沒有人會特地跑去淡水看夕陽。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "所以我到現在還不知道，淡水的夕陽最後長什麼樣子。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "好吃。……下次還可以來嗎？",
   "h": 10.526,
   "d": 21,
   "z": "daybreak",
   "adv": true
  }
