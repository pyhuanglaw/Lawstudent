{"tag": "romtier_a1", "sha": "bc53f04880", "meet": {"stage": "CLOSE_FRIEND", "rel": {"fam": 71, "trust": 50, "comf": 46}, "money": 22000}, "book": {"lines": ["▶ 吃飯…公館燒臘、SUNNY SIDE、Daybreak、洋洋鹹酥雞、泰米村食、越好吃小館、客居雲南", "▶ 去公館燒臘吃飯", "▶ 今天 19:00", "沈以安（手機）｜好。我要叉燒飯。", "｜約好 今天 19:00，公館燒臘。"], "menus": [["念書…2:30 AM、總圖、法律學院圖書館、afar café", "吃飯…公館燒臘、SUNNY SIDE、Daybreak、洋洋鹹酥雞、泰米村食、越好吃小館、客居雲南", "喝咖啡、喝茶…2:30 AM、一盞、afar café", "散步…溫州街、映月湖", "運動…新體育館羽球場、椰影大道", "出去玩…你們現在是朋友。再多相處一陣子。", "算了"], ["去公館燒臘吃飯", "去 SUNNY SIDE 吃早午餐", "去 Daybreak 吃早午餐", "去洋洋鹹酥雞吃宵夜", "去泰米村食吃飯", "去越好吃小館吃河粉", "去客居雲南吃米線", "返回"], ["今天 19:00", "今天 21:00", "明天 12:10", "明天 19:00", "其他日子…之後 7 天內選一天", "算了"]], "iv": {"id": "iv1", "who": "heroine_01", "place": "noodle", "zone": "noodle", "day": 393, "h": 19, "state": "accepted", "accepted": true, "by": "player", "now": false, "label": "和沈以安約在公館燒臘", "kxd": 1}}, "arrive_log": [{"ms": 71953, "h": 19.135, "zone": "noodle", "who": "沈以安", "t": "下次考試前一起讀吧。我先跟你約好。"}, {"ms": 73006, "h": 19.135, "zone": "noodle", "who": "沈以安", "t": "你先點。我想一下。"}, {"ms": 73636, "h": 19.135, "zone": "noodle", "who": "", "t": "（她把菜單從頭看到尾，最後點的是第一頁第一個。）"}, {"ms": 75936, "h": 19.51, "zone": "noodle", "who": "沈以安", "t": "你知道女舍的門禁是十二點嗎？"}, {"ms": 76787, "h": 19.51, "zone": "noodle", "who": "沈以安", "t": "我昨天十一點五十九分進門。舍監看了我一眼。"}, {"ms": 78088, "h": 19.51, "zone": "noodle", "who": "沈以安", "t": "我從來沒有那麼晚回去過。是讀書會拖到的。"}, {"ms": 78752, "h": 19.51, "zone": "noodle", "who": "沈以安", "t": "你呢？你上一次做規則以外的事，是什麼時候？"}, {"ms": 80772, "h": 19.51, "zone": "noodle", "who": "祐廷", "t": "有一次半夜睡不著，我騎車去河堤吹風。"}, {"ms": 81421, "h": 19.51, "zone": "noodle", "who": "沈以安", "t": "一個人？"}, {"ms": 82051, "h": 19.51, "zone": "noodle", "who": "", "t": "（她想了一下，好像在想那是什麼樣子。）"}, {"ms": 83707, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "憲法第八條，是本文裡最長的一條。你知道為什麼嗎？"}, {"ms": 85287, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "這是一半。"}, {"ms": 85901, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "新店有一個地方，以前是軍事法庭和看守所。現在是博物館。"}, {"ms": 87185, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "我一直想去看一次。"}, {"ms": 87803, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "一個人去的話，我會一直寫筆記。所以還沒去。"}, {"ms": 89069, "h": 19.885, "zone": "noodle", "who": "沈以安", "t": "第一頁第一個是對的。我運氣不錯。"}, {"ms": 109497, "h": 8.209, "zone": "dorm", "who": "", "t": "早安。今天的課：09:10　民法債編總論（二）　法律系館A 201"}], "arrive": {"her": [{"zone": "noodle", "h": 19.12, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "read", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 6.34, "pSeat": false}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.13, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -2.1, "z": -2.58, "seat": true, "pose": "sit", "beh": "idle", "lv": 0, "id": "heroine_01", "charId": "heroine_01", "d": 1.24, "pSeat": true}, {"zone": "noodle", "h": 19.51, "x": -