dom": "url(\"assets/bg/linze_201.webp\")", "cls": "on image narr", "mkImg": "assets/bg/linze_201.webp", "homeImg": "assets/bg/home_dining_day.webp", "zone": "library", "seat": false}, {"k": "say", "t": "4／5　確定判決命乙清償 50 萬元。判決確定後，乙已經全部清償，債權人甲仍持判決聲請強制執行。乙在執行程序終結前，可以提起什麼訴訟？", "d": "2029-06-26", "h": 10, "active": true, "isMk": true, "isHome": false, "img": "assets/bg/linze_201.webp", "dom": "url(\"assets/bg/linze_201.webp\")", "cls": "on image narr", "mkImg": "assets/bg/linze_201.webp", "homeImg": "assets/bg/home_dining_day.webp", "zone": "library", "seat": false}, {"k": "say", "t": "5／5　甲持有乙親筆簽名的借據，乙到期不還。甲可不可以直接拿這張借據，向法院聲請強制執行？", "d": "2029-06-26", "h": 10, "active": true, "isMk": true, "isHome": false, "img": "assets/bg/linze_201.webp", "dom": "url(\"assets/bg/linze_201.webp\")", "cls": "on image narr", "mkImg": "assets/bg/linze_201.webp", "homeImg": "assets/bg/home_dining_day.webp", "zone": "library", "seat": false}, {"k": "end", "t": "", "d": "2029-06-26", "h": 11, "active": false, "isMk": false, "isHome": false, "img": "assets/bg/linze_201.webp", "dom": "url(\"assets/bg/linze_201.webp\")", "cls": "", "mkImg": "assets/bg/linze_201.webp", "homeImg": "assets/bg/home_dining_day.webp", "zone": "library", "seat": false}, {"k": "mk_end", "t": "true", "d": "2029-06-26", "h": 11, "active": false, "isMk": false, "isHome": false, "img": "assets/bg/linze_201.webp", "dom": "url(\"assets/bg/linze_201.webp\")", "cls": "", "mkImg": "assets/bg/linze_201.webp", "homeImg": "assets/bg/home_dining_day.webp", "zone": "library", "seat": false}]
