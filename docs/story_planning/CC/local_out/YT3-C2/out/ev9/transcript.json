{
 "say": [
  {
   "n": "",
   "c": null,
   "t": "（法律系館B的諮詢室。門開了，進來的是秀琴姨，後面跟著語彤。）",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "（看到你，停了一下）……嗯。我陪秀琴姨來的。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "你們認識？",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "祐廷",
   "c": null,
   "t": "我們在同一家茶屋打工。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "好。那紀錄你照做，意見我來講。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "阿姨，先跟您說，我們都是學生。今天講的，之後會請指導律師再看一次。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "秀琴姨",
   "c": null,
   "t": "學生好啊。學生比較有耐心。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "",
   "c": null,
   "t": "（秀琴姨把租約攤在桌上。語彤把它轉過來，對著柏翰。）",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "（翻到最後一頁）書面的，還有……快兩年。您一直住在那裡，對吧？",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "秀琴姨",
   "c": null,
   "t": "十五年了。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "那這樣。房子賣了，租約跟著房子走。新屋主要接著當房東，到期以前，他不能叫您搬。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "秀琴姨",
   "c": null,
   "t": "新屋主說他要重新裝潢，租給學生。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "柏翰",
   "c": "classmate_bohan",
   "t": "那是到期以後的事。到期以前，他要等。這快兩年，可以拿來準備怎麼跟他談續約。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "秀琴姨",
   "c": null,
   "t": "談？跟屋主談？我只會煮飯耶。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "秀琴姨，所以才要準備。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "",
   "c": null,
   "t": "（秀琴姨看了她一眼，笑出來。）",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "秀琴姨",
   "c": null,
   "t": "好啦，聽妳們的。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "剛剛他講的那個，我這學期也在上。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "在課本上看的時候，覺得好整齊。坐在秀琴姨旁邊聽，就不整齊了。",
   "at": "2027-05-22 9.38 wancai_semb"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "今天先不要。今天我只想陪她。",
   "at": "2027-05-22 9.38 wancai_semb"
  }
 ],
