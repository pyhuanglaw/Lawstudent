y_hall", "who": "杜可昕", "t": "我回宿舍了。今天謝謝你。"}], "iv": {"id": "iv1", "who": "kexin", "place": "library", "zone": "library_hall", "day": 393, "h": 15.636, "state": "done", "accepted": true, "by": "player", "now": false, "label": "和杜可昕約在總圖", "kxd": 1, "rem": 1, "waitSeat": null, "opened": 1, "faDone": 1, "lead": null}}}