{"sha": "6106fae2d2", "ev": {"ev_sis_w1": {"info": {"id": "ev_sis_w1", "title": "直屬學姊", "retired": null, "loc": ["campus", "cafe", "library", "library_hall"], "time": null, "day": "2025-09-01", "participants": ["heroine_05"], "trigger": "interact", "background": "blur", "n": 17}, "lines": [{"who": "", "t": "（她坐在總圖門口的台階上看手機，頭髮綁成馬尾。你認得她—", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "祐廷", "t": "學姊好，我是祐廷，法律系大一。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "溫書瑀", "t": "（抬頭）喔，hi。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "溫書瑀", "t": "開學還習慣嗎？", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "祐廷", "t": "還可以。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "溫書瑀", "t": "民法你選哪個老師？", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "祐廷", "t": "周老師。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "溫書瑀", "t": "周老師很熱門。位置要很早去佔。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "祐廷", "t": "真的，前一堂課就要去佔了。", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}, {"who": "溫書瑀", "t": "（笑了一下）對。我要去圖書館了。有問題", "cap": "直屬學姊", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "campus", "h": 19.03}], "done": {"done": 1, "r": true, "zone": "campus", "h": 19.04}, "zone": "campus", "day": "2025-09-01"}, "ev_sis_family_dinner": {"info": {"id": "ev_sis_family_dinner", "title": "家族聚餐", "retired": null, "loc": ["gongguan"], "time": [18, 19.5], "day": "2025-12-01", "participants": ["heroine_05"], "trigger": "auto", "background": "blur", "n": 35}, "lines": [{"who": "", "t": "你先到了。燒臘店的阿姨把你們那一桌的椅子擺好。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "", "t": "18:31。她跑進來，有點喘。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "抱歉。抱歉，我遲到了。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "Kevin 學長", "t": "一分鐘。學姊，一分鐘。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "一分鐘也是遲到。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "祐廷", "t": "學姊好，我是祐廷。我是妳的直屬。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "我知道。群組裡那個名字。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "", "t": "她坐下，從包包拿出一個資料夾。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "周老師歷年的考古題。我整理過，錯的地方", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "下學期的書，開學前我會分。書上標紅的", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "還有——", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "Kevin 學長", "t": "還有傳統！直屬學姊要講一個自己大一的糗", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "……", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "我大一第一次被點名，老師問什麼是「善", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "我大一第一次被點名，老師問什麼是「善意第三人」。我說：心地善良的第三人。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "老師說：「那心地不好的第三人，是不是", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "", "t": "全桌笑。她也笑了一下。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "其實「善意」在法律上是「不知道」的意", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"k": "▶", "pick": "（默默把考古題資料夾收進書包）", "menu": ["（默默把考古題資料夾收進書包）"]}, {"who": "", "t": "學姊看了一眼。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "資料夾回去再看。現在吃飯。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "Kevin 學長", "t": "學姊說吃飯耶！", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}, {"who": "溫書瑀", "t": "下學期的書，我會留給你。", "cap": "家族聚餐", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": [], "zone": "gongguan", "h": 18.04}], "done": {"done": 1, "r": true, "zone": "gongguan", "h": 18.05}, "zone": "gongguan", "day": "2025-12-01"}, "ev_grad_debate": {"info": {"id": "ev_grad_debate", "title": "和溫學姊吵一次", "retired": null, "loc": ["library", "wancai", "cafe"], "time": null, "day": null, "participants": ["heroine_05"], "trigger": "interact", "background": "blur", "n": 18}, "lines": [{"who": "溫書瑀", "t": "（小聲）讀完了？好。第二節，作者說比例原則在這個案型「", "cap": "和溫學姊吵一次", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": ["classmate_bohan"], "zone": "library", "h": 19.04}, {"k": "▶", "pick": "「不同意。他把『必要性』直接跳過了。」你的鉛筆字", "menu": ["「不同意。他把『必要性』直接跳過了。」你的鉛筆字", "「同意，但理由跟他寫的不一樣。」", "「老實說，我不確定我讀懂了。」"]}, {"who": "溫書瑀", "t": "（小聲）對。他跳過了。我第一次讀的時候沒看出來，是許老師指", "cap": "和溫學姊吵一次", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": ["classmate_bohan"], "zone": "library", "h": 19.04}, {"who": "溫書瑀", "t": "（小聲）下次見面，這一段你來講。", "cap": "和溫學姊吵一次", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": ["classmate_bohan"], "zone": "library", "h": 19.04}, {"who": "溫書瑀", "t": "（小聲）……我自己的研究計畫還沒改完", "cap": "和溫學姊吵一次", "bg": {"op": "1", "img": "none", "color": "rgba(10, 12, 18, 0.38)"}, "people": ["classmate_bohan"], "zone": "library", "h": 19.04}], "done": {"done": 1, "r": true, "zone": "library", "h": 19.04}, "zone": "library", "day": "2026-10-14"}, "ev_sis_video": {"info": {"id": "ev_sis_video", "title": "視訊", "retired": null, "loc": ["any"], "time": null, "day": null, "participants": ["heroine_05"], "trigger": "outing", "background": "dark", "n": 82}, "lines": [{"who": "", "t": "（畫面裡她", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "", "t": "（畫面裡她的背後是一面白牆，桌上一杯咖啡。）", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "溫書瑀", "t": "你那邊是早上吧。……我這邊剛寫完報告", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "溫書瑀", "t": "今天有人問我臺灣在哪裡。我畫了一張地", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "溫書瑀", "t": "好，我去睡了。你去吃早餐。", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}], "done": {"done": 1, "r": true, "zone": "dorm", "h": 19.04}, "zone": "dorm", "day": "2026-10-14"}, "ev_sis_video_gf": {"info": {"id": "ev_sis_video_gf", "title": "視訊", "retired": null, "loc": ["any"], "time": null, "day": null, "participants": ["heroine_05"], "trigger": "outing", "background": "dark", "n": 181}, "lines": [{"who": "", "t": "（視訊。", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "", "t": "（視訊。她那邊是週六晚上。你們講到她那邊快十二點，她說要睡了，鏡頭又開了三分鐘才關。）", "cap": "視訊", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/video.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}], "done": {"done": 1, "r": true, "zone": "dorm", "h": 19.05}, "zone": "dorm", "day": "2026-10-14"}, "ev_us_canyon": {"info": {"id": "ev_us_canyon", "title": "秋假：大峽谷", "retired": null, "loc": ["any"], "time": null, "day": null, "participants": ["heroine_05"], "trigger": "outing", "background": "dark", "n": 42}, "lines": [{"who": "", "t": "（她靠在", "cap": "亞利桑那", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_roadside_car.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "", "t": "（她靠在租來的車旁邊，手上拿著一張列印的地圖。）", "cap": "亞利桑那", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_roadside_car.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "溫書瑀", "t": "路線我排好了。上車。", "cap": "亞利桑那", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_roadside_car.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 19.04}, {"who": "", "t": "（沙漠裡的加油站，她買了兩", "cap": "亞利桑那", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_roadside_car.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（第一眼看到", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（第一眼看到峽谷的時候，你們兩個都沒說話。）", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "溫書瑀", "t": "……照片拍不進去。", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（她還是拍了一張，看了一眼，刪掉。", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "溫書瑀", "t": "用看的就好。", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（她在步道上走得比你快。走", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（她在步道上走得比你快。走到一半，她回頭把手伸給你。）", "cap": "大峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/az_canyon.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（汽車旅館的電", "cap": "汽車旅館", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/trip_hotel_twin.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 21}, {"who": "", "t": "（汽車旅館的電視只有三台。她轉到氣象台，看了很久。）", "cap": "汽車旅館", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/trip_hotel_twin.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 21}, {"who": "溫書瑀", "t": "明天峽谷那邊風大。外套帶厚的。", "cap": "汽車旅館", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/trip_hotel_twin.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 21}, {"who": "", "t": "（她把兩支手機的鬧鐘都設好，才關燈。", "cap": "汽車旅館", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/trip_hotel_twin.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 21}, {"who": "", "t": "（她的論文第四章帶來了，還", "cap": "汽車旅館", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/trip_hotel_twin.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 12}, {"who": "", "t": "（太陽慢慢沉到峽谷另一邊", "cap": "峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_rim_sunset.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 18}, {"who": "", "t": "（太陽慢慢沉到峽谷另一邊。風很大，她把外套拉鍊拉到最上面。）", "cap": "峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_rim_sunset.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 18}, {"who": "溫書瑀", "t": "第四章，我本來想在這裡寫完。", "cap": "峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/gc_rim_sunset.webp\")", "color": "rgba(10, 12, 18, 0.28)"}, "people": [], "zone": "dorm", "h": 18}, {"who": "溫書瑀", "t": "結果一個字都沒寫。", "cap": "峽谷", "bg": {"op": "1", "img": "url(\"http://127.0.0.1:8801/assets/bg/