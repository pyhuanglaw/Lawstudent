   "z": "gongguan"
  },
  {
   "k": "say",
   "n": "",
   "c": null,
   "t": "13／20　以暴力取得自白可能同時涉及人權保障與虛偽自白風險。",
   "d": "2033-08-06",
   "h": 8.5,
   "z": "gongguan"
  },
  {
   "k": "choose",
   "n": "",
   "t": "對｜錯",
