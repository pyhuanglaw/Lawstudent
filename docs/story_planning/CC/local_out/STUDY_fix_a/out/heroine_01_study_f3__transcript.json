 "say": [
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "（小聲）二樓靠窗那排比較安靜。",
   "h": 12.013,
   "d": 21,
   "z": "library_hall",
   "adv": false
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "民總的報告，老師分組那天你沒來。",
   "h": 12.278,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "我把你寫在我這組了。剩下的人裡，你最不會遲交。",
   "h": 12.278,
   "d": 21,
   "z": "library_hall",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（二樓的長桌都坐滿了。）",
   "h": 12.325,
   "d": 21,
   "z": "library_hall",
   "adv": false
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "（小聲）去三樓好了。三樓沒有人講話。",
   "h": 12.325,
   "d": 21,
   "z": "library_hall",
   "adv": false
  },
  {
   "n": "",
   "c": null,
   "t": "（你們在長桌的一角坐下。她把書攤開，把手機翻過來蓋在桌上。）",
   "h": 12.485,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "我讀我的，你讀你的。不懂再問我。",
   "h": 12.485,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她把計時器放在桌角，按了一下。）",
   "h": 12.485,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "你知道女舍的門禁是十二點嗎？",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "我昨天十一點五十九分進門。舍監看了我一眼。",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "我從來沒有那麼晚回去過。是讀書會拖到的。",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "你呢？你上一次做規則以外的事，是什麼時候？",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "祐廷",
   "c": null,
   "t": "有一次半夜睡不著，我騎車去河堤吹風。",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "一個人？",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她想了一下，好像在想那是什麼樣子。）",
   "h": 13.235,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "憲法第八條，是本文裡最長的一條。你知道為什麼嗎？",
   "h": 13.985,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "這是一半。",
   "h": 13.985,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "新店有一個地方，以前是軍事法庭和看守所。現在是博物館。",
   "h": 13.985,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "我一直想去看一次。",
   "h": 13.985,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "沈以安",
   "c": "heroine_01",
   "t": "一個人去的話，我會一直寫筆記。所以還沒去。",
   "h": 13.985,
   "d": 21,
   "z": "library",
   "adv": true
  },
  {
   "n": "",
   "c": null,
   "t": "（她把螢光筆照顏色排回筆袋。）",
