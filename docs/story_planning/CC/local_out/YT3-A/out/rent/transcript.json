{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2026-05-03 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "樟樹換葉，落葉比秋天還多。你掃了一下午，蘇姨說：「它在換衣服。」",
   "at": "2026-05-03 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師說：「今天是你泡的吧。」你沒問他怎麼知道。",
   "at": "2026-05-03 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "烏龍。",
   "at": "2026-05-03 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "第一泡不要給客人。那是洗茶，也是叫醒它。",
   "at": "2026-05-03 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2026-05-03 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把茶巾一條一條晾在緣側。蘇姨泡了一杯給你：「今天你泡得最好的那一種。」",
   "at": "2026-05-03 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。昨天秀琴姨煮完飯，沒有馬上走。",
   "at": "2026-05-03 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "她說她的房東要把房子賣了。她住了十四年。",
   "at": "2026-05-03 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "賣了她要住哪裡。……她問我，我也不知道。",
   "at": "2026-05-03 15.67 wz_teahouse"
  },
  {
   "n": "祐廷",
   "c": null,
   "t": "我上課有聽過，房子賣了租約不一定就沒了。我再查。",
   "at": "2026-05-03 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "嗯。你查到再跟我說。",
   "at": "2026-05-03 15.67 wz_teahouse"
  }
 ],
