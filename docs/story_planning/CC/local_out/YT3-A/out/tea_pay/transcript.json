{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2025-10-26 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "風一來，葉子就往緣側的方向飛。你掃了三次，蘇姨說：「掃一次就好。剩下的是院子的。」",
   "at": "2025-10-26 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你學會溫杯的時候，順便溫自己的手。",
   "at": "2025-10-26 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "冬天的熱可可。不是茶。",
   "at": "2025-10-26 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "呂老師的孫子要來。小孩不喝茶。",
   "at": "2025-10-26 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2025-10-26 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師的位子空了。他喝完會把杯子倒扣，說這樣下一個人知道他走了。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（打烊。蘇姨把兩個薪水袋放在吧檯上，一個寫你的名字，一個寫「語彤」。）",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "這個月的。辛苦了。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（你拆開數了一下。語彤沒有拆，把袋子翻過來又翻回去。）",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "語彤每次都這樣。拿了也不拆。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。我第一次拿到自己賺的錢，是去年暑假。那一包我也沒拆。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "拆了就會花掉。……花掉就不知道它長什麼樣子了。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "樟樹斷了一根枝，蘇姨和祐廷一起清。",
   "at": "2025-10-26 15.67 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": "蘇姨",
   "t": "樹會自己長回來。人要幫它把斷的地方修乾淨。",
   "at": "2025-10-26 15.67 wz_teahouse"
  }
 ],
