{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2026-04-25 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "樟樹換葉，落葉比秋天還多。你掃了一下午，蘇姨說：「它在換衣服。」",
   "at": "2026-04-25 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師說：「今天是你泡的吧。」你沒問他怎麼知道。",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "白茶。",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "這個不用急。你等它，它就好了。",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（門口的風鈴響了。一位穿著套裝的女士站在門口，沒有進來。）",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（語彤端著茶盤轉身，看到她，停住了。）",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……媽。",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（語彤的媽媽看了店裡一圈，又看了女兒手上的茶盤。）",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "語彤的媽媽",
   "c": null,
   "t": "我在外面等妳下班。",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（她走出去，站在對面的騎樓下。一直等到五點。）",
   "at": "2026-04-25 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "最後一桌是兩個學生，聊了三個小時，茶續了五次。他們走的時候很小聲地說謝謝。",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師每週六下午坐在緣側最邊邊的位子。今天他叫住你。",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "年輕人，你知道這條街，以前是一整條嗎？",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "我小時候住在這一排。從這裡走到街尾，一路都是同一條街。",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "那年開了一條大路。我家門口突然變成另一條街的尾巴。",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "房子還在。地，就不知道算誰的了。",
   "at": "2026-04-25 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "他笑了一下，不再說。",
   "at": "2026-04-25 15.67 wz_teahouse"
  }
 ],
