{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2028-10-21 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "風一來，葉子就往緣側的方向飛。你掃了三次，蘇姨說：「掃一次就好。剩下的是院子的。」",
   "at": "2028-10-21 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師說：「今天是你泡的吧。」你沒問他怎麼知道。",
   "at": "2028-10-21 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "東方美人。你倒得太急，茶湯起了泡。",
   "at": "2028-10-21 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "沒關係，它很甜，會原諒你。",
   "at": "2028-10-21 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2028-10-21 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把茶巾一條一條晾在緣側。蘇姨泡了一杯給你：「今天你泡得最好的那一種。」",
   "at": "2028-10-21 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "你看過了喔。……蘇姨也看了。她說寫得太短。",
   "at": "2028-10-21 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "樟樹斷了一根枝，蘇姨和祐廷一起清。",
   "at": "2028-10-21 15.67 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": "蘇姨",
   "t": "樹會自己長回來。人要幫它把斷的地方修乾淨。",
   "at": "2028-10-21 15.67 wz_teahouse"
  }
 ],
