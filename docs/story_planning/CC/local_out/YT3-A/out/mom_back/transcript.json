{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2026-05-02 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "樟樹換葉，落葉比秋天還多。你掃了一下午，蘇姨說：「它在換衣服。」",
   "at": "2026-05-02 13.01 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師說：「今天是你泡的吧。」你沒問他怎麼知道。",
   "at": "2026-05-02 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "冬天的熱可可。不是茶。",
   "at": "2026-05-02 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "呂老師的孫子要來。小孩不喝茶。",
   "at": "2026-05-02 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "上禮拜她媽媽來了，站在門口等她下班。……兩個人走的時候都沒講話。",
   "at": "2026-05-02 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把燈籠點亮。院子裡的樹一下子變成了另一棵樹。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。上禮拜那個是我媽。她臨時來找我，樓下警衛跟她說我在這裡。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "她說，我讓妳來台北是念書的，不是端茶的。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "她說，妳要不要再考一次牙醫。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我說，這是我自己選的。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "她說隨便我。……她沒有說隨便我，可是我就當她說了。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "不想。……我想知道別人怎麼過日子。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我媽在淡水開牙醫診所。……我一個人住學校對面，是她買的房子。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師每週六下午坐在緣側最邊邊的位子。今天他叫住你。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "年輕人，你知道這條街，以前是一整條嗎？",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "我小時候住在這一排。從這裡走到街尾，一路都是同一條街。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "那年開了一條大路。我家門口突然變成另一條街的尾巴。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "房子還在。地，就不知道算誰的了。",
   "at": "2026-05-02 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "他笑了一下，不再說。",
   "at": "2026-05-02 15.67 wz_teahouse"
  }
 ],
