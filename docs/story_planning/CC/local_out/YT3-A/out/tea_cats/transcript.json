{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2025-09-27 13.02 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "風一來，葉子就往緣側的方向飛。你掃了三次，蘇姨說：「掃一次就好。剩下的是院子的。」",
   "at": "2025-09-27 13.02 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把水沖得太急，蘇姨說水會被你嚇到。",
   "at": "2025-09-27 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "東方美人。你倒得太急，茶湯起了泡。",
   "at": "2025-09-27 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "沒關係，它很甜，會原諒你。",
   "at": "2025-09-27 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2025-09-27 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "最後一桌是兩個學生，聊了三個小時，茶續了五次。他們走的時候很小聲地說謝謝。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……嗯。你下班有事嗎？",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "要不要一起去找公園的貓？大安森林公園那邊，晚上會有好幾隻出來。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（公園的長椅旁邊，一隻橘貓從草叢裡走出來，在語彤腳邊坐下。）",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "牠每天都在這裡。我叫牠「橘子」。……很普通的名字。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（她蹲下來，摸了摸貓的頭。）",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我很想養一隻。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "祐廷",
   "c": null,
   "t": "那就養啊。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我一個人住。白天上課、週末打工，牠會常常自己待在家。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……那樣不好。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "嗯。我是新北人，家在淡水。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我爸媽離婚了。上大學以前，我跟我媽住。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "淡水到學校太遠，我媽就在學校附近買了房子給我住。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "晚上有一個阿姨會來煮飯。秀琴姨。……她煮的比茶屋的點心好吃。不要跟蘇姨說。",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（橘子吃完你們帶來的小魚乾，走回草叢裡。）",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（你沒有再問。你們坐著看橘子走遠，坐到十點。）",
   "at": "2025-09-27 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……謝謝你陪我找貓。",
   "at": "2025-09-27 15.67 wz_teahouse"
  }
 ],
