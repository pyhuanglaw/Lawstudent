{
 "say": [
  {
   "n": "蘇姨",
   "c": null,
   "t": "上週落葉沒人掃。院子很高興。",
   "at": "2027-06-05 13.02 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "蟬很吵。石板路曬得發燙，你潑了一桶水，院子安靜了一點。",
   "at": "2027-06-05 13.02 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師說：「今天是你泡的吧。」你沒問他怎麼知道。",
   "at": "2027-06-05 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "白茶。",
   "at": "2027-06-05 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "這個不用急。你等它，它就好了。",
   "at": "2027-06-05 14.34 wz_teahouse"
  },
  {
   "n": "蘇姨",
   "c": null,
   "t": "水溫不要太高，烏龍會苦。",
   "at": "2027-06-05 14.34 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "你把茶巾一條一條晾在緣側。蘇姨泡了一杯給你：「今天你泡得最好的那一種。」",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（打烊。蘇姨先走了。語彤在數今天的零錢，數到一半停下來。）",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我想幫秀琴姨付新房子的押金。萬一到期真的要搬。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我跟她說了，她不收。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "那她要什麼？",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（她的聲音第一次變大）",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "我有的就只有錢。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "陳語彤",
   "c": "heroine_03",
   "t": "……我知道。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "（她把零錢收好，先走了。）",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "呂老師每週六下午坐在緣側最邊邊的位子。今天他叫住你。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "年輕人，你知道這條街，以前是一整條嗎？",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "我小時候住在這一排。從這裡走到街尾，一路都是同一條街。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "那年開了一條大路。我家門口突然變成另一條街的尾巴。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "呂老師",
   "c": "呂老師",
   "t": "房子還在。地，就不知道算誰的了。",
   "at": "2027-06-05 15.67 wz_teahouse"
  },
  {
   "n": "",
   "c": null,
   "t": "他笑了一下，不再說。",
   "at": "2027-06-05 15.67 wz_teahouse"
  }
 ],
