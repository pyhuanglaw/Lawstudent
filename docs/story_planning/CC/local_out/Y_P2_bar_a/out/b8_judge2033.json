 "epilogue": [
  [
   "五年後",
   ""
  ],
  [
   "2034 年 6 月 3 日",
   "兩點半 Café"
  ],
  [
   "",
   "（兩點半 Café。窗邊那張雙人桌坐滿了人，旁邊的桌子都被併過來了。）"
  ],
  [
   "",
   "（阿哲的習慣。五年了，還是一樣。）"
  ],
  [
   "Alison",
   "他現在每次都說『有事』。很煩。"
  ],
  [
   "阿哲",
   "有事啊。我餓了。"
  ],
  [
   "許柏翰",
   "我在念博士班，論文寫刑訴的證據排除。寫得很慢。"
  ],
  [
   "沈以安",
   "我在事務所做公司跟證券的案子。合約一份兩百頁，我每一頁都看。"
  ],
  [
   "不認識的女生",
   "我在事務所，租賃的案子比較多。"
  ],
  [
   "不認識的女生",
   "阿姨說你很久沒來了。下禮拜二來吃。"
  ],
  [
   "阿凱",
   "……喔對，你現在是律師。"
  ],
  [
   "郭沛珊",
   "我學生問我為什麼當老師。"
  ],
  [
   "郭沛珊",
   "我說：因為大一的時候，我發現自己比較想知道框外面的人在想什麼。"
  ],
  [
   "杜可昕",
   "書狀寫到一半。……先吃。"
  ],
  [
   "",
   "cg_reunion_window_table_kexin"
  ],
  [
   "阿哲",
   "你一直都是這樣。誰有事，你就先去查。"
  ],
  [
   "祐廷",
   "我在法扶。這禮拜開了三個庭。"
  ],
  [
   "祐廷",
   "司法官考過一次，沒有上。後來的日子很快，一年一年就過去了。現在站在當事人旁邊，我覺得也很好。"
  ],
  [
   "祐廷",
   "律師證書是 2033 年拿到的。晚了一點，可是是我自己走到的。"
